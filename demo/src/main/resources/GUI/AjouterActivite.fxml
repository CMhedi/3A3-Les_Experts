<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AjouterActiviteController"
            stylesheets="@ajouterActivite.css"
            styleClass="main-bg">


    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="30"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40">

            <Label text="Ajouter une Activité"
                   styleClass="title-label"/>


            <GridPane hgap="10" vgap="10">
                <padding><Insets top="15"/></padding>

                <Label text="Nom :" GridPane.rowIndex="0"/>
                <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Type :" GridPane.rowIndex="1"/>
                <ComboBox fx:id="typeBox" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Catégorie :" GridPane.rowIndex="2"/>
                <ComboBox fx:id="categorieBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Niveau :" GridPane.rowIndex="3"/>
                <ComboBox fx:id="niveauBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Prix :" GridPane.rowIndex="4"/>
                <TextField fx:id="prixField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Statut :" GridPane.rowIndex="5"/>
                <ComboBox fx:id="statutBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Image URL :" GridPane.rowIndex="6"/>
                <TextField fx:id="imageField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">
                <Button text="Ajouter"
                        onAction="#ajouterActivite"
                        styleClass="primary-button"/>

                <Button text="Administrateur"
                        onAction="#goAdmin"
                        styleClass="secondary-button"/>

            </HBox>

        </VBox>
    </children>
</AnchorPane>
