<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.AdminSeanceController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="18"
              alignment="TOP_LEFT">

            <!-- LOGO -->
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="logo"/>
                <Label text="Adventure" styleClass="logo-accent"/>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- MENU -->
            <Button styleClass="menu-btn"
                    defaultButton="false"
                    maxWidth="Infinity"
                    onAction="#handleRetour">
                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="15"
                                         fill="WHITE"/>
                </graphic>
                <text>Retour Plannings</text>
            </Button>



        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="top-bar">

            <Label fx:id="planningLabel"
                   text="Séances du planning"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8"
                  alignment="CENTER"
                  styleClass="user-chip">

                <FontAwesomeIconView glyphName="USER"
                                     size="14"
                                     fill="WHITE"/>

                <Label text="Admin"
                       styleClass="user-name"/>
            </HBox>

        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="25"
              alignment="TOP_CENTER"
              style="-fx-padding:30;">

            <!-- TABLE CARD -->
            <VBox styleClass="card" spacing="20">

                <!-- ===== SEARCH BAR ===== -->
                <HBox spacing="10" alignment="CENTER_LEFT">

                    <FontAwesomeIconView glyphName="SEARCH"
                                         size="14"
                                         fill="#1f4d36"/>

                    <TextField fx:id="searchField"
                               promptText="Rechercher (date, coach, statut...)"
                               HBox.hgrow="ALWAYS"
                               styleClass="search-field"/>
                </HBox>


                <TableView fx:id="seanceTable"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colNom" text="Nom"/>

                        <TableColumn fx:id="colDate" text="Date"/>
                        <TableColumn fx:id="colDebut" text="Début"/>
                        <TableColumn fx:id="colFin" text="Fin"/>
                        <TableColumn fx:id="colCapacite" text="Capacité"/>
                        <TableColumn fx:id="colStatut" text="Statut"/>
                        <TableColumn fx:id="colCoach" text="Coach"/>
                    </columns>
                </TableView>

                <!-- ACTION BUTTONS -->
                <HBox spacing="18"
                      alignment="CENTER">

                    <Button fx:id="btnAjouter"
                            styleClass="btn-primary"
                            onAction="#handleAdd">
                        <graphic>
                            <FontAwesomeIconView glyphName="PLUS"
                                                 size="11"
                                                 fill="WHITE"/>
                        </graphic>
                        <text>Ajouter</text>
                    </Button>

                    <Button fx:id="btnModifier"
                            styleClass="btn-secondary"
                            onAction="#handleUpdate">
                        <graphic>
                            <FontAwesomeIconView glyphName="PENCIL"
                                                 size="11"
                                                 fill="WHITE"/>
                        </graphic>
                        <text>Modifier</text>
                    </Button>

                    <Button fx:id="btnSupprimer"
                            styleClass="btn-danger"
                            onAction="#handleDelete">
                        <graphic>
                            <FontAwesomeIconView glyphName="TRASH"
                                                 size="11"
                                                 fill="WHITE"/>
                        </graphic>
                        <text>Supprimer</text>
                    </Button>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
