<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16"
      style="-fx-background-color:#f1f5f9;-fx-padding:24;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminMessagerieDetailController">

    <!-- ══ HEADER ══════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;-fx-padding:16 20;">

        <Button text="← Retour" onAction="#onRetour"
                style="-fx-background-color:#f1f5f9;-fx-text-fill:#475569;-fx-background-radius:8;-fx-border-color:#e2e8f0;-fx-border-radius:8;-fx-cursor:hand;-fx-font-weight:bold;-fx-padding:7 14;"/>

        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitre" text="—"
                   style="-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
            <HBox spacing="12">
                <Label fx:id="lblType" text="—"
                       style="-fx-font-size:12;-fx-text-fill:#64748b;"/>
                <Label fx:id="lblDateCreation" text=""
                       style="-fx-font-size:12;-fx-text-fill:#94a3b8;"/>
            </HBox>
        </VBox>

        <Button text="🚫 Bannir (vider)" onAction="#onBanConversation"
                style="-fx-background-color:#f59e0b;-fx-text-fill:white;-fx-background-radius:8;-fx-cursor:hand;-fx-font-weight:bold;-fx-padding:7 14;"/>
        <Button text="🗑 Supprimer" onAction="#onDeleteConversation"
                style="-fx-background-color:#ef4444;-fx-text-fill:white;-fx-background-radius:8;-fx-cursor:hand;-fx-font-weight:bold;-fx-padding:7 14;"/>
    </HBox>

    <!-- ══ CONTENT ════════════════════════════════════════════ -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- ── LEFT: Messages + Composer ── -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">

            <!-- Messages card -->
            <VBox spacing="0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">

                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding:14 18;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                    <Label text="Messages"
                           style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    <Label fx:id="lblNbMessages" text="0 message(s)"
                           style="-fx-font-size:12;-fx-text-fill:#64748b;"/>
                </HBox>

                <TableView fx:id="tblMessages" prefHeight="340"
                           style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <columns>
                        <TableColumn fx:id="colMsgUser"    text="Auteur"   prefWidth="130"/>
                        <TableColumn fx:id="colMsgType"    text="Type"     prefWidth="110"/>
                        <TableColumn fx:id="colMsgContenu" text="Contenu"  prefWidth="260"/>
                        <TableColumn fx:id="colMsgStatut"  text="Statut"   prefWidth="100" style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colMsgDate"    text="Date"     prefWidth="130" style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colMsgActions" text="Actions"  prefWidth="110" style="-fx-alignment:CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun message dans cette conversation."
                               style="-fx-text-fill:#94a3b8;-fx-font-size:13;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Admin composer card -->
            <VBox spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding:12 18;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                    <Label text="✉  Envoyer un message (admin)"
                           style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:12 16;">
                    <TextField fx:id="txtAdminMsg" promptText="Saisir un message en tant qu'administrateur…"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-radius:8;-fx-border-color:#e2e8f0;-fx-border-radius:8;-fx-padding:8 12;"/>
                    <Button text="➤ Envoyer" onAction="#onEnvoyerMessage"
                            style="-fx-background-color:#0f766e;-fx-text-fill:white;-fx-background-radius:8;-fx-cursor:hand;-fx-font-weight:bold;-fx-padding:8 16;"/>
                </HBox>
                <Label fx:id="lblComposerFeedback" text=""
                       style="-fx-font-size:12;-fx-padding:0 16 10 16;-fx-text-fill:#64748b;"/>
            </VBox>
        </VBox>

        <!-- ── RIGHT: Participants ── -->
        <VBox spacing="0" prefWidth="240" minWidth="220"
              style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">

            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:14 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                <Label text="👥 Participants"
                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
            </HBox>
            <Label fx:id="lblNbParticipants" text="0 participant(s)"
                   style="-fx-font-size:11;-fx-text-fill:#64748b;-fx-padding:6 16 0 16;"/>
            <ListView fx:id="lstParticipants" VBox.vgrow="ALWAYS"
                      style="-fx-background-color:transparent;-fx-border-color:transparent;-fx-font-size:13;"/>
        </VBox>
    </HBox>

</VBox>
