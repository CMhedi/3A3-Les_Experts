<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="0" prefHeight="620" prefWidth="940"
      style="-fx-background-color:#f1f5f9;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminMessagerieDetailController">

    <!-- ══ LEFT SIDEBAR ════════════════════════════════════════ -->
    <VBox prefWidth="260" minWidth="240"
          style="-fx-background-color:#1e293b;">

        <!-- Brand / back -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding:16 14 14 14;
                     -fx-border-color:#334155;-fx-border-width:0 0 1 0;">
            <Button text="←" onAction="#onRetour"
                    style="-fx-background-color:#334155;-fx-text-fill:white;
                           -fx-background-radius:8;-fx-cursor:hand;
                           -fx-font-weight:bold;-fx-font-size:14;-fx-padding:5 10;"/>
            <Label text="EcoAdventure"
                   style="-fx-text-fill:white;-fx-font-size:15;-fx-font-weight:bold;"/>
        </HBox>

        <!-- Conversation info -->
        <VBox spacing="7"
              style="-fx-padding:14 14 12 14;
                     -fx-border-color:#334155;-fx-border-width:0 0 1 0;">
            <Label fx:id="lblTitre" text="—"
                   style="-fx-text-fill:white;-fx-font-size:14;-fx-font-weight:bold;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblType" text="—"
                       style="-fx-font-size:11;-fx-text-fill:white;
                              -fx-background-color:#3b82f6;
                              -fx-background-radius:10;-fx-padding:2 8;"/>
                <Label fx:id="lblDateCreation" text=""
                       style="-fx-font-size:11;-fx-text-fill:#94a3b8;"/>
            </HBox>
            <!-- Action buttons -->
            <HBox spacing="8" style="-fx-padding:4 0 0 0;">
                <Button text="🚫 Vider" onAction="#onBanConversation"
                        style="-fx-background-color:#f59e0b;-fx-text-fill:white;
                               -fx-background-radius:7;-fx-cursor:hand;
                               -fx-font-size:11;-fx-padding:5 10;-fx-font-weight:bold;"/>
                <Button text="🗑 Supprimer" onAction="#onDeleteConversation"
                        style="-fx-background-color:#ef4444;-fx-text-fill:white;
                               -fx-background-radius:7;-fx-cursor:hand;
                               -fx-font-size:11;-fx-padding:5 10;-fx-font-weight:bold;"/>
            </HBox>
        </VBox>

        <!-- Participants header -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding:12 14 6 14;">
            <Label text="👥 Participants"
                   style="-fx-text-fill:#94a3b8;-fx-font-size:11;-fx-font-weight:bold;"/>
            <Label fx:id="lblNbParticipants" text="0"
                   style="-fx-background-color:#334155;-fx-text-fill:#94a3b8;
                          -fx-background-radius:10;-fx-padding:1 7;-fx-font-size:10;"/>
        </HBox>

        <!-- Participants list -->
        <ListView fx:id="lstParticipants" VBox.vgrow="ALWAYS"
                  style="-fx-background-color:transparent;-fx-border-color:transparent;"/>
    </VBox>

    <!-- ══ RIGHT: CHAT AREA ════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0"
          style="-fx-background-color:#f8fafc;">

        <!-- Chat header -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:white;-fx-padding:14 20;
                     -fx-border-color:#e2e8f0;-fx-border-width:0 0 1 0;">
            <Label fx:id="lblChatTitre" text="—"
                   style="-fx-font-size:15;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNbMessages" text="0 message(s)"
                   style="-fx-background-color:#f1f5f9;-fx-text-fill:#64748b;
                          -fx-background-radius:10;-fx-padding:3 10;-fx-font-size:12;"/>
        </HBox>

        <!-- Scrollable bubble area -->
        <ScrollPane fx:id="scrollMessages" fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color:#f8fafc;-fx-background:#f8fafc;
                           -fx-border-color:transparent;">
            <VBox fx:id="vboxMessages" spacing="10"
                  style="-fx-padding:16 20 16 20;"/>
        </ScrollPane>

        <!-- Admin composer -->
        <VBox spacing="0"
              style="-fx-background-color:white;
                     -fx-border-color:#e2e8f0;-fx-border-width:1 0 0 0;">
            <HBox spacing="10" alignment="CENTER"
                  style="-fx-padding:12 16;">
                <TextField fx:id="txtAdminMsg"
                           promptText="Envoyer un message en tant qu'administrateur…"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:#f1f5f9;-fx-background-radius:20;
                                  -fx-border-color:transparent;
                                  -fx-padding:10 16;-fx-font-size:13;"/>
                <Button text="➤" onAction="#onEnvoyerMessage"
                        style="-fx-background-color:#10b981;-fx-text-fill:white;
                               -fx-background-radius:50;-fx-cursor:hand;
                               -fx-font-weight:bold;-fx-font-size:14;
                               -fx-min-width:40;-fx-min-height:40;
                               -fx-max-width:40;-fx-max-height:40;"/>
            </HBox>
            <Label fx:id="lblComposerFeedback" text=""
                   style="-fx-font-size:11;-fx-padding:0 16 8 16;-fx-text-fill:#64748b;"/>
        </VBox>
    </VBox>

</HBox>
