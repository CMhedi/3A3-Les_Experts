<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PackListController"
            styleClass="adb-root"
            stylesheets="@/css/admin-pack-dashboard.css">

    <center>
        <VBox styleClass="adb-stack" spacing="0" VBox.vgrow="ALWAYS" BorderPane.alignment="CENTER">

            <VBox styleClass="adb-hero" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="18">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="ECOADVENTURE · STUDIO" styleClass="adb-hero-kicker"/>
                        <Label text="📦  Gestion des Packs" styleClass="adb-hero-title"/>
                        <Label text="Créez, modifiez et gérez les packs — vue cartes."
                               styleClass="adb-hero-sub" wrapText="true"/>
                    </VBox>
                    <VBox spacing="8" alignment="TOP_RIGHT">
                        <Label fx:id="lblActifs" text="— actifs" styleClass="adb-pill adb-pill-actif"/>
                        <Label fx:id="lblInactifs" text="— inactifs" styleClass="adb-pill adb-pill-inactif"/>
                    </VBox>
                </HBox>

                <HBox styleClass="adb-kpi-deck" alignment="CENTER_LEFT" spacing="12">
                    <VBox styleClass="adb-kpi-glass" minWidth="120" prefWidth="160" spacing="4">
                        <Label text="PACKS (CATALOGUE)" styleClass="adb-kpi-lbl"/>
                        <Label fx:id="lblKpiPacks" text="0" styleClass="adb-kpi-val"/>
                    </VBox>
                    <VBox styleClass="adb-kpi-glass" minWidth="120" prefWidth="160" spacing="4">
                        <Label text="ACTIFS" styleClass="adb-kpi-lbl"/>
                        <Label fx:id="lblKpiActifs" text="0" styleClass="adb-kpi-val"/>
                    </VBox>
                    <VBox styleClass="adb-kpi-glass" minWidth="120" prefWidth="180" spacing="4">
                        <Label text="PRIX MOYEN (DT)" styleClass="adb-kpi-lbl"/>
                        <Label fx:id="lblKpiPrixMoyen" text="0" styleClass="adb-kpi-val"/>
                    </VBox>
                </HBox>

                <HBox styleClass="adb-toolbar" alignment="CENTER_LEFT" spacing="12">
                    <HBox styleClass="adb-search" alignment="CENTER_LEFT" spacing="8" maxWidth="440" HBox.hgrow="SOMETIMES">
                        <TextField fx:id="txtSearch"
                                   promptText="Rechercher (nom, type, statut)…"
                                   styleClass="adb-search-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="lblTotal" text="0 / 0" styleClass="adb-count"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="＋ Ajouter" onAction="#onAdd" styleClass="adb-btn-add"/>
                    <Button text="✎ Modifier" onAction="#onEdit" styleClass="adb-btn-ghost"/>
                    <Button text="✕ Supprimer" onAction="#onDelete" styleClass="adb-btn-danger"/>
                    <Button text="↻ Rafraîchir" onAction="#onRefresh" styleClass="adb-btn-ghost"/>
                    <Button text="PDF / QR" onAction="#onOpenQrPdfDialog" styleClass="adb-btn-ghost"/>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        styleClass="adb-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="20" fillWidth="true">
                    <FlowPane fx:id="rowsBox" styleClass="adb-flow"/>
                    <VBox fx:id="chartsHost" styleClass="adb-charts-wrap" spacing="14"/>
                </VBox>
            </ScrollPane>

            <HBox styleClass="adb-footer" alignment="CENTER_LEFT">
                <Label fx:id="lblFooter"
                       text="Sélectionnez une carte · double-clic pour modifier."
                       styleClass="adb-footer-text"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
