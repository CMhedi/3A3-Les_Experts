<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@/css/PackList.css"
            styleClass="pack-page"
            fx:controller="controllers.PackListController">

    <top>
        <VBox spacing="12" BorderPane.alignment="CENTER" styleClass="top-wrap">
            <padding>
                <Insets top="18" right="18" bottom="10" left="18"/>
            </padding>

            <Label text="Gestion des Packs" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
                <TextField fx:id="txtSearch"
                           promptText="Rechercher (nom / type / statut)..."
                           styleClass="search"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Ajouter" onAction="#onAdd" styleClass="btn-primary"/>
                <Button text="Modifier" onAction="#onEdit" styleClass="btn-secondary"/>
                <Button text="Supprimer" onAction="#onDelete" styleClass="btn-danger"/>
                <Button text="Rafraîchir" onAction="#onRefresh" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="0" right="18" bottom="0" left="18"/>
            </padding>

            <ScrollPane fitToWidth="true" prefHeight="520" styleClass="table-wrap">
                <content>
                    <VBox style="-fx-background-color: transparent;">

                        <HBox spacing="0" styleClass="table-header">
                            <Label text="Nom" prefWidth="240" styleClass="th"/>
                            <Label text="Type" prefWidth="170" styleClass="th"/>
                            <Label text="Prix" prefWidth="120" styleClass="th"/>
                            <Label text="Max activités" prefWidth="140" styleClass="th"/>
                            <Label text="Statut" prefWidth="140" styleClass="th"/>
                        </HBox>

                        <VBox fx:id="rowsBox" spacing="6" style="-fx-padding: 10 0 0 0;"/>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="bottom-bar">
            <padding>
                <Insets top="10" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="Affiché / Total :" styleClass="muted"/>
            <Label fx:id="lblTotal" text="0" styleClass="total"/>
        </HBox>
    </bottom>

</BorderPane>