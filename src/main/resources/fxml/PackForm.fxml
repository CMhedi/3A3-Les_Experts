<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.PackFormController"
      stylesheets="@/css/PackForm.css"
      spacing="16" styleClass="dialog-root">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label fx:id="lblTitle" text="Ajouter un pack" styleClass="dialog-title"/>

    <VBox styleClass="dialog-card" spacing="12">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints percentWidth="35"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>

            <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNom" promptText="Ex: Premium"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Type :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbType" promptText="Choisir un type"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Prix de base :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrixBase" promptText="ex: 50.00"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Réduction :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtReduction" promptText="ex: 5.00"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Nb activités max :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Spinner fx:id="spMax" prefWidth="140"
                     GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Statut :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbStatut" promptText="Choisir un statut"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        </GridPane>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button text="Enregistrer" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>

</VBox>
