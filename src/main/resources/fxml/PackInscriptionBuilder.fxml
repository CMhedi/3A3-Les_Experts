<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.stage.FileChooser?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="controllers.PackInscriptionBuilderController"
         tabClosingPolicy="UNAVAILABLE"
         styleClass="page-root"
         stylesheets="@../css/pack-builder.css">

    <tabs>

        <!-- =======================
             TAB 1 — CLIENT
             ======================= -->
        <Tab text="1) Client">
            <content>
                <VBox spacing="14" styleClass="pad">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button text="← Retour" onAction="#handleBack" styleClass="btn-ghost"/>
                        <Label text="Pack Builder — Admin Flow" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblStatus" text="Prêt" styleClass="status-pill status-ok"/>
                    </HBox>

                    <VBox styleClass="card" spacing="12">
                        <padding>
                            <Insets top="14" right="14" bottom="14" left="14"/>
                        </padding>

                        <GridPane hgap="12" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="22"/>
                                <ColumnConstraints percentWidth="78"/>
                            </columnConstraints>

                            <Label text="Client (User ID) :" styleClass="label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Spinner fx:id="spUserId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Résumé :" styleClass="label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblClientSummary" text="—" wrapText="true" styleClass="details"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Risk :" styleClass="label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblRisk" text="—" styleClass="hint"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>

                        <HBox spacing="10">
                            <Button fx:id="btnLoadClient" text="Charger client" styleClass="btn-secondary"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnGoBuild" text="Continuer →" styleClass="btn-primary"/>
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </Tab>

        <!-- =======================
             TAB 2 — BUILD OFFER
             ======================= -->
        <Tab text="2) Build Offer">
            <content>
                <VBox spacing="12" styleClass="pad">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <VBox styleClass="card" spacing="12">
                        <padding>
                            <Insets top="14" right="14" bottom="14" left="14"/>
                        </padding>

                        <GridPane hgap="12" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="22"/>
                                <ColumnConstraints percentWidth="78"/>
                            </columnConstraints>

                            <Label text="Pack :" styleClass="label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="cbPack" promptText="Choisir un pack..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Nb personnes :" styleClass="label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Spinner fx:id="spNbPersonnes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Coupon :" styleClass="label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtCoupon" promptText="Optionnel (ex: PROMO10)" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label fx:id="lblMaxAct" text="Max activités : --" styleClass="hint"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
                        <TextField fx:id="txtSearch" promptText="Rechercher activité (nom/catégorie/niveau)..." HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSelectMax" text="Sélectionner max" styleClass="btn-secondary"/>
                        <Label fx:id="lblSelected" text="0 sélectionnée(s)" styleClass="hint"/>
                    </HBox>

                    <VBox styleClass="tw-wrap">
                        <HBox spacing="12" styleClass="tw-header" alignment="CENTER_LEFT">
                            <Label text="✓" styleClass="tw-hcell" prefWidth="34"/>
                            <Label text="Nom" styleClass="tw-hcell" HBox.hgrow="ALWAYS"/>
                            <Label text="Catégorie" styleClass="tw-hcell" prefWidth="140"/>
                            <Label text="Niveau" styleClass="tw-hcell" prefWidth="120"/>
                            <Label text="Prix" styleClass="tw-hcell" prefWidth="120"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" prefViewportHeight="260" styleClass="tw-scroll">
                            <content>
                                <VBox fx:id="vbRows" spacing="8" styleClass="tw-body"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <HBox spacing="10">
                        <Button fx:id="btnCalculer" text="Calculer" styleClass="btn-secondary"/>
                        <Button fx:id="btnRiskGate" text="Vérifier risque" styleClass="btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnGoDevis" text="Continuer →" styleClass="btn-primary"/>
                    </HBox>

                </VBox>
            </content>
        </Tab>

        <!-- =======================
             TAB 3 — DEVIS
             ======================= -->
        <Tab text="3) Devis">
            <content>
                <VBox spacing="12" styleClass="pad">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <VBox styleClass="card" spacing="10">
                        <padding>
                            <Insets top="14" right="14" bottom="14" left="14"/>
                        </padding>

                        <Label text="Devis / Pricing" styleClass="section-title"/>

                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="28"/>
                                <ColumnConstraints percentWidth="72"/>
                            </columnConstraints>

                            <Label text="Pack base :" styleClass="label-muted" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblPackBase" text="--" styleClass="price-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Activités total :" styleClass="label-muted" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblActTotal" text="--" styleClass="price-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Réduction pack :" styleClass="label-muted" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDiscountPack" text="--" styleClass="price-discount" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Réduction groupe :" styleClass="label-muted" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDiscountGroupe" text="--" styleClass="price-discount" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Coupon :" styleClass="label-muted" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDiscountCoupon" text="--" styleClass="price-discount" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="TOTAL :" styleClass="total-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <Label fx:id="lblTotal" text="--" styleClass="total-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Détails :" styleClass="label-muted" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <Label fx:id="lblDetails" text="" wrapText="true" styleClass="details"
                                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <Label text="Expiry :" styleClass="label-muted" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                            <Label fx:id="lblExpiry" text="—" styleClass="hint" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>

                    <HBox spacing="10">
                        <Button fx:id="btnCreateDraft" text="Créer Draft + HOLD" styleClass="btn-primary"/>
                        <Button fx:id="btnDevisPdf" text="Devis PDF + QR" styleClass="btn-secondary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnGoPayment" text="Continuer →" styleClass="btn-primary"/>
                    </HBox>

                </VBox>
            </content>
        </Tab>

        <!-- =======================
             TAB 4 — PAYMENT & CONFIRM
             ======================= -->
        <Tab text="4) Payment &amp; Confirm">
            <content>
                <VBox spacing="12" styleClass="pad">
                    <padding>
                        <Insets top="18" right="18" bottom="18" left="18"/>
                    </padding>

                    <VBox styleClass="card" spacing="12">
                        <padding>
                            <Insets top="14" right="14" bottom="14" left="14"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Paiement sécurisé" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPayBadge" text="SANDBOX" styleClass="badge-warn"/>
                        </HBox>

                        <VBox spacing="8" styleClass="subcard">
                            <Label text="Méthode" styleClass="label-muted"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <RadioButton fx:id="rbCard" text="Carte bancaire"/>
                                <RadioButton fx:id="rbPaypal" text="PayPal"/>
                                <RadioButton fx:id="rbLink" text="Lien Checkout"/>
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxCardForm" spacing="10" styleClass="subcard">
                            <Label text="Carte bancaire" styleClass="label-muted"/>

                            <GridPane hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="55"/>
                                    <ColumnConstraints percentWidth="25"/>
                                    <ColumnConstraints percentWidth="20"/>
                                </columnConstraints>

                                <TextField fx:id="txtCardName" promptText="Nom sur la carte" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="txtCardExpiry" promptText="MM/YY" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <PasswordField fx:id="txtCardCvv" promptText="CVV" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

                                <TextField fx:id="txtCardNumber" promptText="Numéro carte" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
                            </GridPane>

                            <!-- OCR + Test presets -->
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="btnScanOcr" text="Scan Card (OCR)" styleClass="btn-secondary"/>
                                <Label text="Exemples (TEST):" styleClass="label-muted"/>
                                <Button fx:id="btnFillVisaGold" text="Visa Gold" styleClass="btn-secondary"/>
                                <Button fx:id="btnFillMaster" text="Mastercard" styleClass="btn-secondary"/>
                                <Button fx:id="btnFillAmex" text="Amex" styleClass="btn-secondary"/>
                                <Button fx:id="btnClearCard" text="Vider" styleClass="btn-secondary"/>
                            </HBox>

                            <Label fx:id="lblCardHint" text="—" styleClass="label-muted"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="btnPayNow" text="Payer" styleClass="btn-primary"/>
                                <ProgressIndicator fx:id="piPay" prefWidth="22" prefHeight="22" visible="false" managed="false"/>
                                <Label fx:id="lblPayStatus" text="—" styleClass="label-muted"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnFake3ds" text="Simuler 3DS" styleClass="btn-secondary"/>
                            </HBox>
                        </VBox>

                        <VBox fx:id="boxLink" spacing="8" styleClass="subcard">
                            <Label text="Lien Checkout" styleClass="label-muted"/>
                            <TextField fx:id="txtPaymentLink" promptText="Payment link..." editable="false"/>
                            <HBox spacing="10">
                                <Button fx:id="btnOpenPayment" text="Ouvrir paiement" styleClass="btn-secondary"/>
                                <Button fx:id="btnSendEmail" text="Envoyer email" styleClass="btn-secondary"/>
                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8" styleClass="subcard">
                            <Label text="Reçu / Référence" styleClass="label-muted"/>
                            <TextArea fx:id="txtReceipt" prefRowCount="5" wrapText="true" editable="false"/>
                            <HBox spacing="10">
                                <Button fx:id="btnCopyReceipt" text="Copier reçu" styleClass="btn-secondary"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnConfirm" text="Confirmer réservation" styleClass="btn-danger"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </VBox>
            </content>
        </Tab>

    </tabs>
</TabPane>