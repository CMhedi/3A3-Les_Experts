<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InscriptionListController"
            style="-fx-background-color: #f1f5f9;">

    <!-- ═══════════ TOP — barre titre + actions ═══════════ -->
    <top>
        <VBox style="-fx-background-color: #1E293B; -fx-padding: 16 20 14 20;"
              spacing="10">

            <HBox spacing="14" alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label text="📋  Inscriptions"
                           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: 800;"/>
                    <Label text="Suivi des inscriptions liées aux packs EcoAdventure."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="＋ Ajouter" onAction="#onAdd"
                        style="-fx-background-color: #F37021; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 8;
                               -fx-padding: 7 16 7 16; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch"
                           promptText="🔍  Rechercher (utilisateur, pack, statut, montant, date)…"
                           prefWidth="420"
                           style="-fx-background-color: #334155; -fx-text-fill: white;
                                  -fx-prompt-text-fill: #64748b; -fx-background-radius: 8;
                                  -fx-border-color: transparent; -fx-padding: 7 12 7 12;
                                  -fx-font-size: 13;"/>
                <Label fx:id="lblTotal" text="Affiché / Total : 0"
                       style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button text="✉ WhatsApp" onAction="#onWhatsApp"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                <Button text="✎ Modifier"  onAction="#onEdit"
                        style="-fx-background-color: #334155; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                <Button text="✕ Supprimer" onAction="#onDelete"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                <Button text="↻ Rafraîchir" onAction="#onRefresh"
                        style="-fx-background-color: #334155; -fx-text-fill: #94a3b8;
                               -fx-background-radius: 8; -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════ CENTER — tableau ═══════════ -->
    <center>
        <VBox BorderPane.alignment="CENTER"
              style="-fx-padding: 20;" spacing="0">

            <VBox spacing="0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);
                         -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;">

                <!-- En-tête colonnes -->
                <HBox spacing="0"
                      style="-fx-background-color: #1E293B;
                             -fx-background-radius: 12 12 0 0;
                             -fx-padding: 12 14 12 14;">
                    <Label text="UTILISATEUR"
                           prefWidth="200"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 0 0 0 4;"/>
                    <Label text="PACK"
                           prefWidth="200"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Label text="DATE"
                           prefWidth="150"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Label text="MONTANT (DT)"
                           prefWidth="120"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Label text="STATUT INSCR."
                           prefWidth="140"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Label text="PASSERELLE"
                           prefWidth="110"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <Label text="PAIEMENT"
                           prefWidth="110"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: bold;"/>
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;"/>

                <!-- Corps scrollable — lignes injectées par InscriptionListController -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="rowsBox" spacing="0" fillWidth="true"
                              style="-fx-background-color: white; -fx-padding: 2 0 4 0;"/>
                    </content>
                </ScrollPane>

                <!-- Pied de tableau -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: #f8fafc;
                             -fx-background-radius: 0 0 12 12;
                             -fx-border-color: #e2e8f0 transparent transparent transparent;
                             -fx-border-width: 1; -fx-padding: 8 14 8 14;">
                    <Label text="💡 Double-clic sur une ligne pour modifier."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
