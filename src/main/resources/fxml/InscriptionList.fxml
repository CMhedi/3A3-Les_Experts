<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InscriptionListController"
            styleClass="adi-root"
            stylesheets="@/css/admin-inscription-dashboard.css">

    <center>
        <VBox spacing="0" VBox.vgrow="ALWAYS" BorderPane.alignment="CENTER">

            <VBox styleClass="adi-hero" spacing="12">
                <VBox spacing="5">
                    <Label text="LIVE · INSCRIPTIONS" styleClass="adi-hero-kicker"/>
                    <Label text="📋  Inscriptions aux packs" styleClass="adi-hero-title"/>
                    <Label text="Suivi des demandes, statuts et paiements — vue cartes."
                           styleClass="adi-hero-sub" wrapText="true"/>
                </VBox>

                <HBox styleClass="adi-kpi-deck" alignment="CENTER_LEFT" spacing="12">
                    <VBox styleClass="adi-kpi-glass" minWidth="100" prefWidth="130" spacing="4">
                        <Label text="TOTAL" styleClass="adi-kpi-lbl"/>
                        <Label fx:id="lblKpiTotal" text="0" styleClass="adi-kpi-val"/>
                    </VBox>
                    <VBox styleClass="adi-kpi-glass" minWidth="100" prefWidth="130" spacing="4">
                        <Label text="EN ATTENTE" styleClass="adi-kpi-lbl"/>
                        <Label fx:id="lblKpiAttente" text="0" styleClass="adi-kpi-val"/>
                    </VBox>
                    <VBox styleClass="adi-kpi-glass" minWidth="100" prefWidth="130" spacing="4">
                        <Label text="CONFIRMÉES" styleClass="adi-kpi-lbl"/>
                        <Label fx:id="lblKpiConfirme" text="0" styleClass="adi-kpi-val"/>
                    </VBox>
                    <VBox styleClass="adi-kpi-glass" minWidth="120" prefWidth="160" spacing="4">
                        <Label text="MONTANT (DT)" styleClass="adi-kpi-lbl"/>
                        <Label fx:id="lblKpiMontant" text="0" styleClass="adi-kpi-val"/>
                    </VBox>
                </HBox>

                <HBox styleClass="adi-toolbar" alignment="CENTER_LEFT" spacing="12">
                    <HBox styleClass="adi-search" alignment="CENTER_LEFT" spacing="8" maxWidth="480" HBox.hgrow="SOMETIMES">
                        <TextField fx:id="txtSearch"
                                   promptText="Rechercher (utilisateur, pack, statut, montant, date)…"
                                   styleClass="adi-search-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="lblTotal" text="Affiché / Total : 0" styleClass="adi-count"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="＋ Ajouter" onAction="#onAdd" styleClass="adi-btn-add"/>
                    <Button text="✉ WhatsApp" onAction="#onWhatsApp" styleClass="adi-btn-wa"/>
                    <Button text="✎ Modifier" onAction="#onEdit" styleClass="adi-btn-ghost"/>
                    <Button text="✕ Supprimer" onAction="#onDelete" styleClass="adi-btn-danger"/>
                    <Button text="↻ Rafraîchir" onAction="#onRefresh" styleClass="adi-btn-ghost"/>
                </HBox>
            </VBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        styleClass="adi-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="20" fillWidth="true">
                    <FlowPane fx:id="rowsBox" styleClass="adi-flow"/>
                    <VBox fx:id="chartsHost" styleClass="adi-charts-wrap" spacing="14"/>
                </VBox>
            </ScrollPane>

            <HBox styleClass="adi-footer" alignment="CENTER_LEFT">
                <Label text="Double-clic sur une carte pour modifier · WhatsApp nécessite une inscription sélectionnée."
                       styleClass="adi-footer-text"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
