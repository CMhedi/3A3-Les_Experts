<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.InscriptionFormController"
      stylesheets="@/css/InscriptionForm.css"
      spacing="14" styleClass="page">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <Label text="Inscription" styleClass="page-title"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65"/>
        </columnConstraints>

        <Label text="Utilisateur :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbUser" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Pack :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPack" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Statut :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatut" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Réduction :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lblDiscount" text="0%" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Montant :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMontant" editable="false" promptText="Calculé automatiquement"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button text="Enregistrer" onAction="#onSave" styleClass="btn-primary"/>
    </HBox>
</VBox>
