<?xml version="1.0" encoding="UTF-8"?>
    <?import javafx.geometry.Insets?>
    <?import javafx.scene.chart.BarChart?>
    <?import javafx.scene.chart.CategoryAxis?>
    <?import javafx.scene.chart.NumberAxis?>
    <?import javafx.scene.chart.PieChart?>
    <?import javafx.scene.control.*?>
    <?import javafx.scene.layout.*?>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color:#f1f5f9;-fx-background:#f1f5f9;"
                xmlns="http://javafx.com/javafx/17"
                xmlns:fx="http://javafx.com/fxml/1"
                fx:controller="controllers.AdminMessagerieController">

        <VBox spacing="16" style="-fx-background-color:#f1f5f9;-fx-padding:20;">

            <!-- ══ HEADER ══════════════════════════════════════════════ -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="💬 Gestion de la Messagerie"
                       style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch"
                           promptText="🔍 Rechercher Utilisateurs, Conversations…"
                           prefWidth="320"
                           style="-fx-background-radius:20;-fx-border-color:#e2e8f0;-fx-border-radius:20;-fx-padding:8 16;-fx-font-size:13;"/>
                <ComboBox fx:id="cmbType" prefWidth="130"
                          style="-fx-background-radius:8;-fx-font-size:13;"/>
                <Button text="🔄 Actualiser" onAction="#onRefresh"
                        style="-fx-background-color:#0f766e;-fx-text-fill:white;-fx-background-radius:8;-fx-cursor:hand;-fx-font-weight:bold;-fx-padding:8 16;-fx-font-size:13;"/>
            </HBox>

            <!-- ══ KPI CARDS ══════════════════════════════════════════ -->
            <HBox spacing="12">
                <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:linear-gradient(to right,#3b82f6,#1d4ed8);-fx-background-radius:12;-fx-padding:16 20;">
                    <Label text="💬  Conversations"
                           style="-fx-text-fill:rgba(255,255,255,.85);-fx-font-size:11;-fx-font-weight:bold;"/>
                    <Label fx:id="kpiConversations" text="—"
                           style="-fx-text-fill:white;-fx-font-size:26;-fx-font-weight:bold;"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:linear-gradient(to right,#06b6d4,#0891b2);-fx-background-radius:12;-fx-padding:16 20;">
                    <Label text="👥  Groupes"
                           style="-fx-text-fill:rgba(255,255,255,.85);-fx-font-size:11;-fx-font-weight:bold;"/>
                    <Label fx:id="kpiGroupes" text="—"
                           style="-fx-text-fill:white;-fx-font-size:26;-fx-font-weight:bold;"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:linear-gradient(to right,#10b981,#059669);-fx-background-radius:12;-fx-padding:16 20;">
                    <Label text="✉  Messages (7 j)"
                           style="-fx-text-fill:rgba(255,255,255,.85);-fx-font-size:11;-fx-font-weight:bold;"/>
                    <Label fx:id="kpiMessages7j" text="—"
                           style="-fx-text-fill:white;-fx-font-size:26;-fx-font-weight:bold;"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:linear-gradient(to right,#8b5cf6,#6d28d9);-fx-background-radius:12;-fx-padding:16 20;">
                    <Label text="👤  Utilisateurs actifs"
                           style="-fx-text-fill:rgba(255,255,255,.85);-fx-font-size:11;-fx-font-weight:bold;"/>
                    <Label fx:id="kpiActifs" text="—"
                           style="-fx-text-fill:white;-fx-font-size:26;-fx-font-weight:bold;"/>
                </VBox>
            </HBox>

            <!-- ══ CONVERSATIONS TABLE ════════════════════════════════ -->
            <VBox spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding:12 18;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                    <Label text="Toutes les Conversations"
                           style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConvCount" text=""
                           style="-fx-font-size:12;-fx-text-fill:#64748b;"/>
                </HBox>
                <TableView fx:id="tblConversations" prefHeight="320"
                           style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <columns>
                        <TableColumn fx:id="colId"             text="ID"            prefWidth="55"  style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colTitre"          text="Titre"         prefWidth="185"/>
                        <TableColumn fx:id="colType"           text="Type"          prefWidth="100" style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colCreateur"       text="Créateur"      prefWidth="175"/>
                        <TableColumn fx:id="colNbParticipants" text="Participants"  prefWidth="95"  style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colNbMessages"     text="Messages"      prefWidth="85"  style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colDate"           text="Date création" prefWidth="115" style="-fx-alignment:CENTER;"/>
                        <TableColumn fx:id="colDernierMsg"     text="Dernier msg"   prefWidth="160"/>
                        <TableColumn fx:id="colActions"        text="Actions"       prefWidth="200" style="-fx-alignment:CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucune conversation trouvée."
                               style="-fx-text-fill:#94a3b8;-fx-font-size:13;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ══ TOP USERS ══════════════════════════════════════════ -->
            <HBox spacing="14">
                <!-- Top actifs -->
                <VBox spacing="0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                        <Label text="🏆  Utilisateurs les plus actifs (Conversations)"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" prefHeight="190"
                                style="-fx-background-color:transparent;-fx-background:transparent;">
                        <VBox fx:id="vboxTopCreateurs" spacing="0"/>
                    </ScrollPane>
                </VBox>
                <!-- Top communicateurs -->
                <VBox spacing="0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                        <Label text="💬  Utilisateurs les plus communicatifs (7 derniers jours)"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" prefHeight="190"
                                style="-fx-background-color:transparent;-fx-background:transparent;">
                        <VBox fx:id="vboxTopCommunicateurs" spacing="0"/>
                    </ScrollPane>
                </VBox>
            </HBox>

            <!-- ══ CHARTS ROW 1 : Distribution + Types messages ══════ -->
            <HBox spacing="14">
                <!-- Distribution des conversations (larger) -->
                <VBox spacing="0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                        <Label text="🥧  Distribution des conversations"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    </HBox>
                    <PieChart fx:id="chartConvTypes" prefHeight="240" legendVisible="true"
                              style="-fx-padding:8;"/>
                </VBox>
                <!-- Types de messages -->
                <VBox spacing="0" prefWidth="360"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                        <Label text="💌  Types de messages (7 derniers jours)"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                    </HBox>
                    <PieChart fx:id="chartMsgTypes" prefHeight="240" legendVisible="true"
                              style="-fx-padding:8;"/>
                </VBox>
            </HBox>

            <!-- ══ CHART ROW 2 : Messages par jour (full-width) ══════ -->
            <VBox spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#e2e8f0;-fx-border-radius:12;">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                    <Label text="📊  Messages par jour (7 derniers jours)"
                           style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>
                </HBox>
                <BarChart fx:id="chartMsgJour" prefHeight="240" legendVisible="false"
                          style="-fx-padding:8;">
                    <xAxis><CategoryAxis label=""/></xAxis>
                    <yAxis><NumberAxis label="" minorTickVisible="false"/></yAxis>
                </BarChart>
            </VBox>

        </VBox>
    </ScrollPane>
