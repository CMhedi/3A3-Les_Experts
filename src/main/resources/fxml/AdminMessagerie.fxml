<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            styleClass="root"
            stylesheets="@/css/app.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminMessagerieController">

<VBox spacing="18" styleClass="page">

    <!-- ══ HEADER ═════════════════════════════════════════════ -->
       <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar card">
              <Label text="💬 Admin Messagerie" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
              <Button text="🔄 Actualiser" onAction="#onRefresh" styleClass="btn-primary"/>
    </HBox>

    <!-- ══ KPI CARDS ══════════════════════════════════════════ -->
       <HBox spacing="14">
              <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" styleClass="card stat-card">
                     <Label text="💬  Conversations" styleClass="muted"/>
                     <Label fx:id="kpiConversations" text="—" styleClass="title"/>
        </VBox>
              <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" styleClass="card stat-card">
                     <Label text="👥  Groupes" styleClass="muted"/>
                     <Label fx:id="kpiGroupes" text="—" styleClass="title"/>
        </VBox>
              <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" styleClass="card stat-card">
                     <Label text="✉  Messages (7 j)" styleClass="muted"/>
                     <Label fx:id="kpiMessages7j" text="—" styleClass="title"/>
        </VBox>
              <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS" styleClass="card stat-card">
                     <Label text="👤  Utilisateurs actifs" styleClass="muted"/>
                     <Label fx:id="kpiActifs" text="—" styleClass="title"/>
        </VBox>
    </HBox>

    <!-- ══ FILTER ROW ═════════════════════════════════════════ -->
       <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card searchBox">
              <Label text="🔍" styleClass="muted"/>
              <TextField fx:id="txtSearch" promptText="Rechercher par titre ou initiateur…"
                               prefWidth="300" styleClass="searchInput"/>
              <ComboBox fx:id="cmbType" prefWidth="130"/>
    </HBox>

    <!-- ══ CONVERSATIONS TABLE ════════════════════════════════ -->
       <VBox spacing="0" styleClass="card surface-card">
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding:14 18;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                     <Label text="Toutes les Conversations" styleClass="title"/>
        </HBox>
              <TableView fx:id="tblConversations" prefHeight="300" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"             text="ID"          prefWidth="55"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colTitre"          text="Titre"       prefWidth="200"/>
                <TableColumn fx:id="colType"           text="Type"        prefWidth="95"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colCreateur"       text="Initiateur"  prefWidth="160"/>
                <TableColumn fx:id="colNbParticipants" text="Membres"     prefWidth="85"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colNbMessages"     text="Messages"    prefWidth="85"  style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colDate"           text="Créée le"    prefWidth="100" style="-fx-alignment:CENTER;"/>
                <TableColumn fx:id="colActions"        text="Actions"     prefWidth="210" style="-fx-alignment:CENTER;"/>
            </columns>
            <placeholder>
                <Label text="Aucune conversation trouvée."
                       style="-fx-text-fill:#94a3b8;-fx-font-size:13;"/>
            </placeholder>
        </TableView>
    </VBox>

    <!-- ══ TOP USERS (with ban buttons) ══════════════════════ -->
    <HBox spacing="14">
        <!-- Top dans conversations -->
       <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="card surface-card">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
              <Label text="🏆  Top Membres actifs" styleClass="title"/>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="200"
                        style="-fx-background-color:transparent;-fx-background:transparent;">
                <VBox fx:id="vboxTopCreateurs" spacing="0"/>
            </ScrollPane>
        </VBox>
        <!-- Top communicateurs -->
       <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="card surface-card">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
              <Label text="💬  Top Communicateurs (7 j)" styleClass="title"/>
            </HBox>
            <ScrollPane fitToWidth="true" prefHeight="200"
                        style="-fx-background-color:transparent;-fx-background:transparent;">
                <VBox fx:id="vboxTopCommunicateurs" spacing="0"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- ══ CHARTS ══════════════════════════════════════════════ -->
    <HBox spacing="14">
        <!-- Pie: types de conversations -->
         <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="card surface-card">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                  <Label text="🥧  Types de conversations" styleClass="title"/>
            </HBox>
            <PieChart fx:id="chartConvTypes" prefHeight="220" legendVisible="true"
                      style="-fx-padding:8;"/>
        </VBox>
        <!-- Bar: messages par jour -->
         <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="card surface-card">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                  <Label text="📊  Messages / jour (7 j)" styleClass="title"/>
            </HBox>
            <BarChart fx:id="chartMsgJour" prefHeight="220" legendVisible="false"
                      style="-fx-padding:8;">
                <xAxis><CategoryAxis label=""/></xAxis>
                <yAxis><NumberAxis label="" minorTickVisible="false"/></yAxis>
            </BarChart>
        </VBox>
        <!-- Pie: types de messages -->
         <VBox spacing="0" HBox.hgrow="ALWAYS" styleClass="card surface-card">
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding:12 16;-fx-border-color:#f1f5f9;-fx-border-width:0 0 1 0;">
                  <Label text="💌  Types de messages (7 j)" styleClass="title"/>
            </HBox>
            <PieChart fx:id="chartMsgTypes" prefHeight="220" legendVisible="true"
                      style="-fx-padding:8;"/>
        </VBox>
    </HBox>

</VBox>
</ScrollPane>
