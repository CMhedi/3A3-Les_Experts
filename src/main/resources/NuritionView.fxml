<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.NutritionController"
            stylesheets="@nutrition.css">

    <VBox spacing="30"
          alignment="TOP_CENTER"
          styleClass="main-container">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT"
              maxWidth="600"
              spacing="10">

            <Button text="← Retour"
                    onAction="#handleRetour"
                    styleClass="btn-retour"/>
        </HBox>

        <!-- ===== TITLE ===== -->
        <Label text="🍏 Dashboard Nutrition &amp; Santé"
               styleClass="title-label"/>

        <!-- ========================================== -->
        <!-- ============ NUTRITION CARD ============== -->
        <!-- ========================================== -->

        <VBox spacing="20"
              maxWidth="600"
              styleClass="card">

            <Label text="Analyse Alimentaire"
                   styleClass="section-title"/>

            <Separator opacity="0.3"/>

            <TextField fx:id="txtIngredient"
                       promptText="Ex: 200g chicken breast ou 1 apple"
                       styleClass="text-field"/>

            <HBox spacing="12"
                  alignment="CENTER_LEFT">

                <Button text="Analyser"
                        onAction="#handleAnalyzeFood"
                        styleClass="primary-btn"/>

                <Button text="Ajouter au journal"
                        onAction="#handleSaveToJournal"
                        styleClass="success-btn"/>

                <Button text="Total aujourd'hui"
                        onAction="#handleTodayTotal"
                        styleClass="secondary-btn"/>
            </HBox>

        </VBox>

        <!-- ========================================== -->
        <!-- =============== IMC CARD ================== -->
        <!-- ========================================== -->

        <VBox spacing="20"
              maxWidth="600"
              styleClass="card">

            <Label text="Calcul IMC"
                   styleClass="section-title"/>

            <Separator opacity="0.3"/>

            <HBox spacing="12"
                  alignment="CENTER_LEFT">

                <TextField fx:id="txtPoids"
                           promptText="Poids en kg (ex: 70 ou 70.5)"
                           HBox.hgrow="ALWAYS"
                           styleClass="text-field"/>

                <TextField fx:id="txtTaille"
                           promptText="Taille en mètres (ex: 1.75 ou 1,75)"
                           HBox.hgrow="ALWAYS"
                           styleClass="text-field"/>

                <Button text="Calculer"
                        onAction="#handleIMC"
                        styleClass="primary-btn"/>
            </HBox>

            <Label fx:id="lblIMC"
                   styleClass="imc-result"/>

            <Label fx:id="lblIMCRemark"
                   wrapText="true"
                   styleClass="imc-remark"/>

        </VBox>

        <!-- ========================================== -->
        <!-- =============== RESULT CARD =============== -->
        <!-- ========================================== -->

        <VBox spacing="25"
              maxWidth="600"
              styleClass="card">

            <Label text="Résultat"
                   styleClass="section-title"/>

            <Separator opacity="0.3"/>

            <VBox spacing="20" alignment="CENTER">

                <!-- Calories -->
                <Label fx:id="lblCalories"
                       text="0 kcal"
                       styleClass="result-calories"/>

                <!-- Macros -->
                <HBox spacing="30" alignment="CENTER">

                    <!-- Protéines -->
                    <VBox alignment="CENTER" spacing="5" styleClass="macro-card protein-card">
                        <Label fx:id="lblProteins" text="0 g" styleClass="macro-value"/>
                        <Label text="Protéines" styleClass="macro-title"/>
                    </VBox>

                    <!-- Lipides -->
                    <VBox alignment="CENTER" spacing="5" styleClass="macro-card fat-card">
                        <Label fx:id="lblFats" text="0 g" styleClass="macro-value"/>
                        <Label text="Lipides" styleClass="macro-title"/>
                    </VBox>

                    <!-- Glucides -->
                    <VBox alignment="CENTER" spacing="5" styleClass="macro-card carb-card">
                        <Label fx:id="lblCarbs" text="0 g" styleClass="macro-value"/>
                        <Label text="Glucides" styleClass="macro-title"/>
                    </VBox>

                </HBox>

                <Label fx:id="lblMessage"
                       styleClass="result-message"/>

            </VBox>

        </VBox>

        <!-- Spacer bottom -->
        <Region prefHeight="20"/>

    </VBox>

</ScrollPane>