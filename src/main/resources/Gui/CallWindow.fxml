<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<!-- ✅ INCOMING CALL WINDOW (RÉCEPTEUR) -->
<!-- fx:controller MUST match your CallController path -->
<VBox alignment="CENTER" spacing="25" prefHeight="450.0" prefWidth="320.0"
      style="-fx-background-color: #121212; -fx-background-radius: 30; -fx-border-color: #333; -fx-border-radius: 30; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.CallController">

    <padding>
        <Insets top="50" bottom="50" left="20" right="20" />
    </padding>

    <!-- ✅ Profile Circle with Emoji -->
    <StackPane>
        <Circle fx:id="profileCircle" fill="#282828" radius="60" stroke="#34c759" strokeWidth="3" />
        <Label text="👤" textFill="WHITE" style="-fx-font-size: 50;">
        </Label>
    </StackPane>

    <!-- ✅ Caller Information -->
    <VBox alignment="CENTER" spacing="10">
        <!-- Caller Name - CRITICAL fx:id -->
        <Label fx:id="callerName" text="John Doe" textFill="WHITE" style="-fx-font-size: 22; -fx-font-weight: bold;">
        </Label>

        <!-- Call Status with Timer - CRITICAL fx:id -->
        <Label fx:id="callStatus" text="Incoming call... 30s" textFill="#b3b3b3" style="-fx-font-size: 14;">
        </Label>
    </VBox>

    <!-- Spacer to push buttons to bottom -->
    <Region VBox.vgrow="ALWAYS" />

    <!-- ✅ Call Action Buttons -->
    <HBox alignment="CENTER" spacing="40">
        <!-- REJECT Button -->
        <Button fx:id="rejectButton" onAction="#handleReject" prefHeight="65" prefWidth="65"
                style="-fx-background-color: #ff3b30; -fx-background-radius: 50; -fx-cursor: hand; -fx-font-size: 24; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(255,59,48,0.4), 10, 0, 0, 0);">
            ✘
        </Button>

        <!-- ACCEPT Button -->
        <Button onAction="#handleAccept" prefHeight="65" prefWidth="65"
                style="-fx-background-color: #34c759; -fx-background-radius: 50; -fx-cursor: hand; -fx-font-size: 24; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(52,199,89,0.4), 10, 0, 0, 0);">
            ✔
        </Button>
    </HBox>

    <!-- Bottom label -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="Tap to answer or reject" textFill="#8e8e8e" style="-fx-font-size: 11;">
        </Label>
    </VBox>

</VBox>
