<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" prefHeight="400.0" prefWidth="300.0"
      style="-fx-background-color: #1a1a1a; -fx-background-radius: 20;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="40" bottom="40" />
    </padding>

    <Circle fx:id="callerImage" fill="#3a3a3a" radius="50" />

    <VBox alignment="CENTER" spacing="5">
        <Label fx:id="callerName" text="Nom du Contact" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />
        <Label fx:id="callStatus" text="Appel audio entrant..." style="-fx-text-fill: #b3b3b3; -fx-font-size: 14;" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER" spacing="40">
        <Button onAction="#handleReject" prefHeight="60" prefWidth="60"
                style="-fx-background-color: #ff3b30; -fx-background-radius: 50; -fx-text-fill: white; -fx-cursor: hand;" text="✘">
            <style>-fx-font-size: 20;</style>
        </Button>

        <Button onAction="#handleAccept" prefHeight="60" prefWidth="60"
                style="-fx-background-color: #34c759; -fx-background-radius: 50; -fx-text-fill: white; -fx-cursor: hand;" text="✔">
            <style>-fx-font-size: 20;</style>
        </Button>
    </HBox>
</VBox>