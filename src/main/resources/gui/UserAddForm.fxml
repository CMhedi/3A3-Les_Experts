<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.UserAddController" style="-fx-background-color: #f1f5f9;">
    <children>
        <HBox spacing="10" style="-fx-background-color: #1B4D3E; -fx-padding: 30;" alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5">
                    <Label text="Inscription Nouveau Membre" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="EcoAdventure : Système de gestion des accès" style="-fx-text-fill: #A7F3D0; -fx-font-size: 13;"/>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="25" style="-fx-padding: 40;">
            <children>
                <VBox spacing="30" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                    <children>
                        <GridPane hgap="30" vgap="25">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                                <ColumnConstraints hgrow="SOMETIMES" percentWidth="50"/>
                            </columnConstraints>
                            <children>
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="NOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                    <TextField fx:id="txtNom" promptText="Saisir le nom" prefHeight="45"
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="PRÉNOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                    <TextField fx:id="txtPrenom" promptText="Saisir le prénom" prefHeight="45"
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="EMAIL PROFESSIONNEL" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                    <TextField fx:id="txtEmail" promptText="email@ecoadventure.com" prefHeight="45"
                                               style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="RÔLE SYSTÈME" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                    <ComboBox fx:id="comboRole" maxWidth="Infinity" prefHeight="45"
                                              style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                </VBox>
                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                    <Label text="SÉCURITÉ DU COMPTE (MOT DE PASSE)" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #1B4D3E;"/>
                                    <PasswordField fx:id="txtPassword" prefHeight="45"
                                                   style="-fx-background-color: #f0fdf4; -fx-border-color: #1B4D3E; -fx-border-radius: 8; -fx-padding: 10;"/>
                                </VBox>
                            </children>
                        </GridPane>

                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button text="ANNULER" onAction="#handleCancel" prefHeight="45" prefWidth="120"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="btnEnregistrer" text="CONFIRMER L'AJOUT" onAction="#handleAdd" prefHeight="45" prefWidth="200"
                                    style="-fx-background-color: #1B4D3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(27,77,62,0.3), 10, 0, 0, 5);"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>