<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.UserReclamationController">
    <stylesheets>
        <URL value="@style_reclamation.css" />
    </stylesheets>
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <children>
                        <Button onAction="#switchToForm" text="⬅ Retour au formulaire" style="-fx-background-color: #f1f5f9; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                        <Label text="Historique de mes demandes" style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #143D30;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleUpdate" text="✏️ Modifier" style="-fx-background-color: #e0f2fe; -fx-text-fill: #0284c7; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                        <Button onAction="#handleDelete" text="🗑 Supprimer" style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20;"/>
                    </children>
                </HBox>

                <TableView fx:id="tableMyRecs" VBox.vgrow="ALWAYS" style="-fx-background-radius: 15; -fx-overflow-x: hidden;">
                    <columns>
                        <TableColumn fx:id="colMyType" text="Type" prefWidth="150"/>
                        <TableColumn fx:id="colMyStatut" text="Statut" prefWidth="150"/>
                        <TableColumn fx:id="colMyContenu" text="Contenu" prefWidth="350"/>
                        <TableColumn fx:id="colMyReponse" text="Réponse Admin" prefWidth="250"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>