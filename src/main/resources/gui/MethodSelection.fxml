<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.MethodSelectionController">
    <children>
        <VBox alignment="CENTER" spacing="10">
            <children>
                <Label text="Sécurisez votre compte" textFill="#1B4D3E" style="-fx-font-weight: bold; -fx-font-size: 22;" />
                <Label text="Où voulez-vous recevoir le code ?" textFill="#7f8c8d" />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <VBox fx:id="btnEmail" onMouseClicked="#selectEmail" alignment="CENTER" spacing="15" prefWidth="150" prefHeight="150"
                      style="-fx-border-color: #e2e8f0; -fx-border-radius: 15; -fx-cursor: hand; -fx-background-color: #f8fafc; -fx-background-radius: 15;">
                    <children>
                        <Label text="📧" style="-fx-font-size: 40;" />
                        <Label text="Par Email" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>

                <VBox fx:id="btnSMS" onMouseClicked="#selectSMS" alignment="CENTER" spacing="15" prefWidth="150" prefHeight="150"
                      style="-fx-border-color: #e2e8f0; -fx-border-radius: 15; -fx-cursor: hand; -fx-background-color: #f8fafc; -fx-background-radius: 15;">
                    <children>
                        <Label text="📱" style="-fx-font-size: 40;" />
                        <Label text="Par SMS" style="-fx-font-weight: bold;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <Button text="Annuler" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand;" />
    </children>
</VBox>