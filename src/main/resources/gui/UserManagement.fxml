<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox fx:id="mainContainer" prefHeight="600.0" prefWidth="1000.0" stylesheets="@styleuser.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.UserManagementController">
    <children>
        <VBox alignment="CENTER_LEFT" prefWidth="450.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 40;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 28px;" text="Inscrivez-vous" textFill="#1B4D3E" />

                <VBox spacing="2">
                    <TextField fx:id="txtNom" promptText="Nom" styleClass="modern-input" />
                    <Label fx:id="errorNom" text="⚠️ Nom obligatoire" textFill="RED" visible="false" style="-fx-font-size: 10;" />
                </VBox>

                <VBox spacing="2">
                    <TextField fx:id="txtPrenom" promptText="Prénom" styleClass="modern-input" />
                    <Label fx:id="errorPrenom" text="⚠️ Prénom obligatoire" textFill="RED" visible="false" style="-fx-font-size: 10;" />
                </VBox>

                <VBox spacing="2">
                    <TextField fx:id="txtEmail" promptText="Email" styleClass="modern-input" />
                    <Label fx:id="errorEmail" text="" textFill="RED" visible="false" style="-fx-font-size: 10;" />
                </VBox>

                <VBox spacing="2">
                    <TextField fx:id="txtTel" promptText="Téléphone" styleClass="modern-input" />
                    <Label fx:id="errorTel" text="⚠️ 8 chiffres requis" textFill="RED" visible="false" style="-fx-font-size: 10;" />
                </VBox>

                <VBox spacing="2">
                    <PasswordField fx:id="txtMdp" promptText="Mot de passe" styleClass="modern-input" />
                    <Label fx:id="errorMdp" text="⚠️ Minimum 6 caractères" textFill="RED" visible="false" style="-fx-font-size: 10;" />
                </VBox>

                <VBox spacing="2">
                    <ComboBox fx:id="comboRole" prefHeight="40.0" prefWidth="350.0" promptText="Choisir un Rôle" styleClass="modern-combo" />
                </VBox>

                <Button fx:id="btnAjouter" onAction="#handleAjouter" prefHeight="45.0" prefWidth="350.0" styleClass="main-button" text="REGISTER" />

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Vous avez déjà un compte ?" textFill="#7f8c8d" />
                        <Label onMouseClicked="#handleGoToLogin" style="-fx-cursor: hand; -fx-font-weight: bold;" text="Se connecter" textFill="#3498DB" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <AnchorPane style="-fx-background-color: #2a7760; -fx-background-radius: 50 0 0 50;" HBox.hgrow="ALWAYS">
            <children>
                <Circle fill="#ffffff11" radius="200.0" AnchorPane.bottomAnchor="-50.0" AnchorPane.rightAnchor="-50.0" />
                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <ImageView fitHeight="161.0" fitWidth="249.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@logo_eco.png" />
                    </ImageView>
                    <Label style="-fx-font-style: italic; -fx-font-size: 16px;" text="Votre évasion commence ici" textFill="WHITE" />
                </VBox>
            </children>
        </AnchorPane>
    </children>
</HBox>
