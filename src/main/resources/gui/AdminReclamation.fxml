<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" styleClass="main-container" stylesheets="@style_admin.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AdminReclamationController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="header-title" text="Centre de Support" />
                                <Label styleClass="header-subtitle" text="Gestion et suivi des réclamations clients" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" styleClass="search-box">
                            <children>
                                <TextField fx:id="txtSearch" promptText="Rechercher une réclamation..." styleClass="search-field" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox styleClass="stat-card, stat-pending" HBox.hgrow="ALWAYS">
                            <Label text="En Attente" styleClass="stat-label"/>
                            <Label fx:id="lblPending" text="12" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-card, stat-done" HBox.hgrow="ALWAYS">
                            <Label text="Traitées" styleClass="stat-label"/>
                            <Label fx:id="lblDone" text="45" styleClass="stat-value"/>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="25.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="content-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="card-title" text="Liste des Réclamations" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox spacing="15" alignment="CENTER">
                                            <children>
                                                <HBox spacing="5" alignment="CENTER">
                                                    <Circle radius="5" fill="#F37021"/>
                                                    <Label text="En Attente" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                                                </HBox>
                                                <HBox spacing="5" alignment="CENTER">
                                                    <Circle radius="5" fill="#28a745"/>
                                                    <Label text="Traitée" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                                                </HBox>
                                                <HBox spacing="5" alignment="CENTER">
                                                    <Circle radius="5" fill="#dc3545"/>
                                                    <Label text="Rejetée" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <TableView fx:id="tableReclamations" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colUser" prefWidth="80.0" text="Utilisateur" />
                                        <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
                                        <TableColumn fx:id="colStatut" prefWidth="100.0" text="État" />
                                        <TableColumn fx:id="colReponse" prefWidth="250.0" text="Réponse Admin" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox prefWidth="380.0" spacing="20.0" styleClass="content-card">
                            <children>
                                <Label styleClass="card-title" text="Détails du message" />
                                <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <TextArea fx:id="areaContenu" editable="false" prefHeight="350.0" styleClass="modern-textarea" wrapText="true" />

                                        <VBox spacing="10.0" alignment="BOTTOM_CENTER">
                                            <children>
                                                <Button maxWidth="Infinity" onAction="#handleOpenResponse" styleClass="btn, btn-success" text="✉ Répondre au Client" />
                                                <HBox spacing="10">
                                                    <children>
                                                        <Button maxWidth="Infinity" onAction="#handleRejeter" HBox.hgrow="ALWAYS" styleClass="btn, btn-warning" text="Rejeter" />
                                                        <Button maxWidth="Infinity" onAction="#handleDelete" HBox.hgrow="ALWAYS" styleClass="btn, btn-danger" text="Supprimer" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>