<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="30.0" prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">
    <children>
        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Bienvenue à EcoAdventure">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Text>
        <HBox alignment="CENTER" spacing="50.0">
            <children>
                <Button fx:id="btnClient" mnemonicParsing="false" onAction="#goToClient"
                        prefHeight="100.0" prefWidth="150.0" text="Espace Client"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" />
                <Button fx:id="btnAdmin" mnemonicParsing="false" onAction="#goToAdmin"
                        prefHeight="100.0" prefWidth="150.0" text="Espace Admin"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>