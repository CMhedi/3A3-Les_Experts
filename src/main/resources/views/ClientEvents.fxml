<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ClientEventsController"
      stylesheets="@/styles/app.css" styleClass="root"
      spacing="0" VBox.vgrow="ALWAYS">

    <HBox styleClass="topbar" spacing="15" alignment="CENTER_LEFT">
        <Label text="Événements Disponibles" styleClass="pageTitle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="searchBox">
            <TextField fx:id="searchField" promptText="Rechercher un événement..."
                       onKeyReleased="#onSearch" styleClass="searchInput"/>
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="transparentScroll" VBox.vgrow="ALWAYS">
        <VBox fx:id="clientCardsContainer" spacing="20" styleClass="pageContent">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>
        </VBox>
    </ScrollPane>
</VBox>
