<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="800.0" prefWidth="1250.0" style="-fx-background-color: #f8fafc;" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="controllers.AdminDashboardController"
            stylesheets="@/styles/app.css">
    
    <left>
        <VBox styleClass="sidebar-admin" prefWidth="260" spacing="20">
            <VBox spacing="6" style="-fx-padding: 0 0 30 0;">
                <Label text="EcoAdventure" styleClass="brand" style="-fx-font-size: 24;"/>
                <Label text="Console Administration" styleClass="mutedSidebar"/>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Button text="📈  Vue d'ensemble" maxWidth="Infinity" styleClass="nav-item-admin, nav-item-admin-active" />
                <Button text="📅  Événements" onAction="#goToEvenements" maxWidth="Infinity" styleClass="nav-item-admin" />
                <Button text="🎟️  Réservations" onAction="#goToReservations" maxWidth="Infinity" styleClass="nav-item-admin" />
                <Button text="👤  Utilisateurs" maxWidth="Infinity" styleClass="nav-item-admin" />
            </VBox>

            <Separator opacity="0.1" />
            <Button onAction="#exportToExcel" maxWidth="Infinity" styleClass="action-btn-primary" text="📥  Exporter Rapport Excel" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="transparentScroll">
            <VBox spacing="35" style="-fx-padding: 40;">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5">
                        <Label text="Tableau de bord" styleClass="pageTitle" style="-fx-font-size: 32;"/>
                        <Label text="Bienvenue, voici les dernières performances de votre plateforme." styleClass="mutedText" style="-fx-font-size: 15;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Actualiser" onAction="#refreshDashboard" styleClass="secondaryBtn">
                        <graphic><Label text="🔄"/></graphic>
                    </Button>
                </HBox>

                <!-- Stats Grid -->
                <FlowPane hgap="25" vgap="25">
                    <VBox styleClass="stat-card">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <StackPane styleClass="stat-icon-box" style="-fx-background-color: #ecfdf5;">
                                <Label text="📅" style="-fx-font-size: 20;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="lblTotalEvents" text="0" styleClass="stat-value"/>
                                <Label text="Événements Actifs" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <StackPane styleClass="stat-icon-box" style="-fx-background-color: #eff6ff;">
                                <Label text="🎟️" style="-fx-font-size: 20;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="lblTotalTickets" text="0" styleClass="stat-value"/>
                                <Label text="Billets Vendus" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <StackPane styleClass="stat-icon-box" style="-fx-background-color: #fff7ed;">
                                <Label text="📊" style="-fx-font-size: 20;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="lblAvgFilling" text="0%" styleClass="stat-value"/>
                                <Label text="Taux de Remplissage" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="stat-card">
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <StackPane styleClass="stat-icon-box" style="-fx-background-color: #fef2f2;">
                                <Label text="🌟" style="-fx-font-size: 20;"/>
                            </StackPane>
                            <VBox>
                                <Label fx:id="lblTopCategory" text="---" styleClass="stat-value" style="-fx-font-size: 18;"/>
                                <Label text="Catégorie Top" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </FlowPane>

                <!-- Charts Row -->
                <HBox spacing="30">
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefHeight="400">
                        <Label text="Répartition par Catégorie" styleClass="card-title-lg" style="-fx-padding: 0 0 20 0;"/>
                        <PieChart fx:id="categoryPieChart" legendSide="BOTTOM" labelsVisible="true"/>
                    </VBox>
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefHeight="400">
                        <Label text="Top Ventes (Détail)" styleClass="card-title-lg" style="-fx-padding: 0 0 20 0;"/>
                        <BarChart fx:id="ticketsBarChart" animated="true">
                            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" /></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- Recent Activities Table -->
                <VBox styleClass="chart-card">
                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                        <Label text="Dernières Réservations" styleClass="card-title-lg"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Voir tout" onAction="#goToReservations" styleClass="secondaryBtn" style="-fx-font-size: 12;"/>
                    </HBox>
                    <TableView fx:id="recentReservationsTable" prefHeight="250" styleClass="dashboard-table">
                        <columns>
                            <TableColumn fx:id="colEvent" text="Événement" prefWidth="300" />
                            <TableColumn fx:id="colTickets" text="Billets" prefWidth="100" />
                            <TableColumn fx:id="colDate" text="Date" prefWidth="200" />
                            <TableColumn fx:id="colStatus" text="Statut" prefWidth="150" />
                        </columns>
                        <placeholder>
                            <Label text="Aucune réservation récente" styleClass="mutedText" />
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
