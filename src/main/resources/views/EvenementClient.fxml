<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.EvenementClientController"
            stylesheets="/styles/app.css" styleClass="root">

    <left>
        <VBox styleClass="sidebar" spacing="14" prefWidth="230">
            <VBox spacing="6" styleClass="sidebarHeader">
                <Label text="EcoAdventure" styleClass="brand"/>
                <Label text="Espace Client" styleClass="mutedSidebar"/>
            </VBox>

            <VBox spacing="6" styleClass="sidebarNav">
                <Button text="🎫  Événements" styleClass="navItem navItemActive" onAction="#goToEvenements"/>
                <Button text="📅  Mes Réservations" styleClass="navItem" onAction="#goToReservations"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Button text="⎋  Déconnexion" styleClass="navItem danger" onAction="#logout"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">
            <HBox styleClass="topbar" spacing="12" alignment="CENTER_LEFT">
                <Button text="← Accueil" onAction="#goHome" styleClass="ghostBtn"/>
                <Label text="Événements Disponibles" styleClass="pageTitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="8" styleClass="searchBox" alignment="CENTER_LEFT">
                    <Label text="🔎" styleClass="muted"/>
                    <TextField fx:id="searchField" onKeyReleased="#onSearch" promptText="Chercher par titre ou lieu..." styleClass="searchInput"/>
                </HBox>
                <Button text="Actualiser" onAction="#onRefresh" styleClass="secondaryBtn"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="transparentScroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="cardsContainer" spacing="20" styleClass="pageContent">
                        <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>