<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.EvenementFormController"
      spacing="12"
      style="-fx-background-color: white; -fx-padding: 18;">

    <Label text="Événement" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Titre :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTitre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Description :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtDescription" prefRowCount="3" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Catégorie :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbCategorie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Date :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <DatePicker fx:id="dpDate"/>
            <TextField fx:id="txtHeure" prefWidth="80" promptText="HH:mm"/>
        </HBox>

        <Label text="Lieu :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLieu" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Places :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPlaces" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Statut :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtStatut" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblInfo" text="" style="-fx-text-fill: #b00020;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onCancel"/>
        <Button text="Enregistrer" onAction="#onSave" style="-fx-background-color: #1f8b4c; -fx-text-fill: white;"/>
    </HBox>
</VBox>
