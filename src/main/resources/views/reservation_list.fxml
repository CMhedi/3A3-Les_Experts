<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ReservationClientController"
      stylesheets="@/styles/app.css" styleClass="root"
      spacing="0" VBox.vgrow="ALWAYS">

    <HBox styleClass="topbar" spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
        <VBox spacing="2">
            <Label text="Mes Billets" styleClass="pageTitle" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #064e3b;"/>
            <Label fx:id="lblInfo" text="Chargement..." styleClass="mutedText" style="-fx-font-size: 13px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox styleClass="searchBox" spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color: #f1f5f9; -fx-padding: 8 15; -fx-background-radius: 20;">
            <Label text="🔎" style="-fx-opacity: 0.5;"/>
            <TextField fx:id="searchField" onKeyReleased="#onSearch" promptText="Rechercher par événement..."
                       style="-fx-background-color: transparent; -fx-pref-width: 250;"/>
        </HBox>
        <Button text="🔄" onAction="#onRefresh"
                style="-fx-background-color: #ecfdf5; -fx-text-fill: #064e3b; -fx-background-radius: 50; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparentScroll" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox spacing="30">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
            
            <!-- SECTION RECOMMANDATIONS -->
            <VBox fx:id="recoSection" spacing="15" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Basé sur vos intérêts" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1e293b;"/>
                    <Label text="✨" style="-fx-font-size: 18px;"/>
                </HBox>
                <HBox fx:id="recoContainer" spacing="20">
                    <!-- Recommended cards go here -->
                </HBox>
                <Separator style="-fx-opacity: 0.3;"/>
            </VBox>

            <!-- SECTION BILLETS -->
            <VBox spacing="15">
                <Label text="Vos Billets" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1e293b;"/>
                <VBox fx:id="cardsContainer" spacing="20"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>