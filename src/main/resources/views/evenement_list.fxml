<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.EvenementController" stylesheets="/styles/app.css">

    <left>
        <VBox styleClass="sidebar" spacing="14" prefWidth="230" style="-fx-background-color: #1a252f; -fx-padding: 20;">
            <VBox spacing="6">
                <Label text="EcoAdventure" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18;"/>
                <Label text="Admin" style="-fx-text-fill: #95a5a6;"/>
            </VBox>
            <VBox spacing="6">
                <Button text="🎫  Événements" onAction="#loadEvents" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-pref-width: 190; -fx-padding: 10; -fx-background-radius: 5;"/>
                <Button text="📅  Réservations" onAction="#goToReservations" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-pref-width: 190; -fx-padding: 10;"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="⎋  Déconnexion" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c;"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 25; -fx-border-color: #f0f0f0; -fx-border-width: 0 0 1 0;">
            <Button text="← Accueil" onAction="#goHome" style="-fx-background-color: transparent; -fx-cursor: hand;"/>
            <Label text="Événements" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-background-color: #f1f2f6; -fx-padding: 5 15; -fx-background-radius: 20;">
                <Label text="🔎"/>
                <TextField fx:id="searchField" promptText="Rechercher..." style="-fx-background-color: transparent; -fx-pref-width: 200;"/>
            </HBox>
            <Button text="Rechercher" onAction="#onSearch" style="-fx-background-color: #f0f7ff; -fx-text-fill: #0984e3; -fx-padding: 8 15;"/>
            <Button text="Actualiser" onAction="#onRefresh" style="-fx-background-color: transparent;"/>
            <Button text="＋ Nouveau" onAction="#onAdd" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 20; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-background-color: #f9f9f9; -fx-padding: 20;">
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                    <Label text="Liste des événements" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblInfo" text="Total: 0" style="-fx-text-fill: #95a5a6;"/>
                </HBox>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="cardsContainer" spacing="12"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>