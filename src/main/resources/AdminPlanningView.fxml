<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.AdminPlanningController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="18"
              alignment="TOP_LEFT">

            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="logo"/>
                <Label text="Adventure" styleClass="logo-accent"/>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <Button styleClass="menu-btn"
                    onAction="#handleRetour"
                    maxWidth="Infinity">
                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="15"
                                         fill="WHITE"/>
                </graphic>
                <text>Retour Menu</text>
            </Button>

        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <Label text="Gestion des Plannings"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8"
                  alignment="CENTER"
                  styleClass="user-chip">

                <FontAwesomeIconView glyphName="USER"
                                     size="14"
                                     fill="WHITE"/>

                <Label text="Admin"
                       styleClass="user-name"/>
            </HBox>

        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>

        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color:transparent;">

            <VBox spacing="30"
                  alignment="TOP_CENTER"
                  maxWidth="Infinity"
                  style="-fx-padding:30;">

                <!-- ================= DASHBOARD STATS ================= -->
                <!-- ===== DASHBOARD STATS ===== -->
                <StackPane maxWidth="Infinity">

                    <HBox spacing="30"
                          alignment="CENTER">

                        <VBox styleClass="stat-card" alignment="CENTER" spacing="6">
                            <Label text="Total"/>
                            <Label fx:id="lblTotalPlanning"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox styleClass="stat-card" alignment="CENTER" spacing="6">
                            <Label text="Actifs"/>
                            <Label fx:id="lblActifs"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox styleClass="stat-card" alignment="CENTER" spacing="6">
                            <Label text="Brouillons"/>
                            <Label fx:id="lblBrouillons"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                        <VBox styleClass="stat-card" alignment="CENTER" spacing="6">
                            <Label text="Archives"/>
                            <Label fx:id="lblArchives"
                                   text="0"
                                   styleClass="stat-value"/>
                        </VBox>

                    </HBox>

                </StackPane>

                <!-- ================= RECOMMENDATION CARD ================= -->
                <VBox styleClass="card"
                      spacing="25"
                      alignment="TOP_LEFT"
                      maxWidth="Infinity"
                      style="-fx-padding:30;">

                    <Label text="📊 Recommandations automatiques"
                           style="-fx-font-weight:bold; -fx-font-size:20;" />

                    <Separator/>

                    <HBox spacing="60"
                          alignment="TOP_LEFT"
                          maxWidth="Infinity"
                          HBox.hgrow="ALWAYS">

                        <!-- LEFT COLUMN -->
                        <VBox spacing="20"
                              HBox.hgrow="ALWAYS"
                              maxWidth="Infinity">

                            <VBox spacing="6">
                                <Label text="🔥 Créneau le plus performant"
                                       style="-fx-font-weight:bold; -fx-text-fill:#1f4d36;" />
                                <Label fx:id="lblRecommendationDay"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="👨‍🏫 Coach le plus performant"
                                       style="-fx-font-weight:bold; -fx-text-fill:#1f4d36;" />
                                <Label fx:id="lblRecommendationCoach"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="📈 Mois le plus performant"
                                       style="-fx-font-weight:bold; -fx-text-fill:#1f4d36;" />
                                <Label fx:id="lblRecommendationMonth"
                                       wrapText="true"
                                       maxWidth="Infinity"/>
                            </VBox>

                        </VBox>

                        <!-- RIGHT COLUMN -->
                        <VBox spacing="15"
                              prefWidth="280"
                              minWidth="280"
                              maxWidth="280"
                              style="-fx-background-color:#f8f9fa;
                     -fx-padding:20;
                     -fx-background-radius:18;">

                            <Label text="🏆 Top 3 Coachs"
                                   style="-fx-font-weight:bold; -fx-font-size:16;" />

                            <Separator/>

                            <Label fx:id="lblTopCoach1" wrapText="true"/>
                            <Label fx:id="lblTopCoach2" wrapText="true"/>
                            <Label fx:id="lblTopCoach3" wrapText="true"/>

                        </VBox>

                    </HBox>

                </VBox>

                <!-- ================= TABLE CARD ================= -->
                <VBox styleClass="card"
                      spacing="20"
                      maxWidth="Infinity"
                      VBox.vgrow="ALWAYS">

                    <!-- SEARCH + FILTERS -->
                    <HBox spacing="15" alignment="CENTER_LEFT">

                        <FontAwesomeIconView glyphName="SEARCH"
                                             size="14"
                                             fill="#1f4d36"/>

                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   HBox.hgrow="ALWAYS"
                                   styleClass="search-field"/>

                        <ComboBox fx:id="yearFilter"
                                  promptText="Filtrer par année"/>

                        <ComboBox fx:id="statutFilter"
                                  promptText="Filtrer par statut"/>

                    </HBox>

                    <!-- TABLE -->
                    <TableView fx:id="planningTable"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colPeriode"
                                         text="Nom du Planning"
                                         prefWidth="150"/>

                            <TableColumn fx:id="colDateDebut"
                                         text="Date Début"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colDateFin"
                                         text="Date Fin"
                                         prefWidth="140"/>

                            <TableColumn fx:id="colDuree"
                                         text="Durée (jours)"
                                         prefWidth="120"/>

                            <TableColumn fx:id="colDescription"
                                         text="Description"
                                         prefWidth="300"/>

                            <TableColumn fx:id="colStatut"
                                         text="Statut"
                                         prefWidth="120"/>

                        </columns>

                    </TableView>

                    <!-- ACTION BUTTONS -->
                    <HBox spacing="18"
                          alignment="CENTER">

                        <Button fx:id="btnAjouter"
                                styleClass="btn-primary"
                                onAction="#handleAdd">
                            <text>Ajouter</text>
                        </Button>

                        <Button fx:id="btnModifier"
                                styleClass="btn-secondary"
                                onAction="#handleUpdate">
                            <text>Modifier</text>
                        </Button>

                        <Button fx:id="btnSupprimer"
                                styleClass="btn-danger"
                                onAction="#handleDelete">
                            <text>Supprimer</text>
                        </Button>

                        <Button styleClass="btn-primary"
                                onAction="#handleSeances">
                            <text>Gérer Séances</text>
                        </Button>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>