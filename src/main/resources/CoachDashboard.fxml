<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.CoachDashboardController"
            prefWidth="1250"
            prefHeight="720"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="30"
              alignment="TOP_LEFT">

            <!-- Logo -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="logo"/>
                <Label text="Adventure" styleClass="logo-accent"/>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Retour -->
            <Button styleClass="menu-btn"
                    maxWidth="Infinity"
                    onAction="#handleRetour">

                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="16"
                                         fill="WHITE"/>
                </graphic>

                <text>Retour Menu</text>
            </Button>

        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <VBox spacing="4">
                <Label text="Dashboard Coach"
                       styleClass="title"/>
                <Label text="Gérez vos séances efficacement"
                       styleClass="subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User -->
            <HBox spacing="8"
                  alignment="CENTER"
                  styleClass="user-chip">

                <FontAwesomeIconView glyphName="USER"
                                     size="14"
                                     fill="WHITE"/>

                <Label text="Coach"/>
            </HBox>

        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>

        <VBox spacing="35"
              alignment="TOP_CENTER"
              style="-fx-padding:40;"
              VBox.vgrow="ALWAYS">

            <!-- ================= STAT CARDS ================= -->
            <HBox spacing="30"
                  alignment="CENTER">

                <VBox styleClass="stat-card-pro">
                    <FontAwesomeIconView glyphName="CALENDAR"
                                         size="22"
                                         styleClass="stat-icon"/>
                    <Label text="Total Séances" styleClass="stat-title"/>
                    <Label fx:id="lblTotal"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card-pro">
                    <FontAwesomeIconView glyphName="CLOCK_ALT"
                                         size="22"
                                         styleClass="stat-icon"/>
                    <Label text="Aujourd'hui" styleClass="stat-title"/>
                    <Label fx:id="lblToday"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card-pro">
                    <FontAwesomeIconView glyphName="CHECK_CIRCLE"
                                         size="22"
                                         styleClass="stat-icon"/>
                    <Label text="Terminées" styleClass="stat-title"/>
                    <Label fx:id="lblTerminee"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

            </HBox>

            <!-- ================= TOOLBAR ================= -->
            <HBox alignment="CENTER_LEFT"
                  spacing="25"
                  styleClass="dashboard-toolbar">

                <Label text="Mes Séances"
                       styleClass="section-title-accent"/>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher une séance..."
                           styleClass="search-field-pro"
                           prefWidth="300"/>

                <ComboBox fx:id="statutFilter"
                          prefWidth="180"
                          styleClass="combo-pro"/>

            </HBox>

            <!-- ================= CARDS CONTAINER ================= -->
            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        styleClass="card-scroll"
                        hbarPolicy="NEVER">

                <FlowPane fx:id="cardContainer"
                          styleClass="card-grid"
                          hgap="25"
                          vgap="25"
                          prefWrapLength="1000"
                          alignment="TOP_LEFT"

                          style="-fx-padding: 10 10 30 10;"/>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
