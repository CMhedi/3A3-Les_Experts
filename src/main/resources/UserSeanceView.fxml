<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.UserSeanceController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="20"
              alignment="TOP_LEFT">

            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="logo"/>
                <Label text="Adventure" styleClass="logo-accent"/>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <Button styleClass="menu-btn"
                    maxWidth="Infinity"
                    onAction="#handleRetour">

                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="15"
                                         fill="WHITE"/>
                </graphic>
                <text>Retour Menu</text>
            </Button>
            <Button styleClass="menu-btn "
                    maxWidth="Infinity"
                    onAction="#handleDashboard">

                <graphic>
                    <FontAwesomeIconView glyphName="DASHBOARD"
                                         size="14"
                                         fill="WHITE"/>
                </graphic>

                <text>Mes Séances</text>
            </Button>


        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <Label text="Séances disponibles"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="8"
                  alignment="CENTER"
                  styleClass="user-chip">

                <FontAwesomeIconView glyphName="USER"
                                     size="14"
                                     fill="WHITE"/>

                <Label text="Utilisateur"/>
            </HBox>

        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>

        <VBox spacing="30"
              alignment="TOP_CENTER"
              style="-fx-padding:35;">

            <!-- ===== TITLE + SEARCH ===== -->
            <HBox alignment="CENTER_LEFT"
                  spacing="20"
                  prefWidth="1000">

                <Label text="Liste des Séances"
                       styleClass="section-title-accent"/>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher une séance..."
                           styleClass="search-field-pro"
                           prefWidth="280"/>

            </HBox>

            <!-- ===== CARDS CONTAINER ===== -->
            <ScrollPane fitToWidth="true"
                        styleClass="card-scroll"
                        VBox.vgrow="ALWAYS">

                <FlowPane fx:id="cardContainer"
                          hgap="22"
                          vgap="22"
                          prefWrapLength="950"
                          alignment="TOP_LEFT"
                          style="-fx-padding: 10 20 20 0;"/>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
