<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.UserSeanceController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox styleClass="sidebar"
              spacing="25"
              alignment="TOP_LEFT">

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="logo"/>
                <Label text="Adventure" styleClass="logo-accent"/>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <Button styleClass="menu-btn"
                    maxWidth="Infinity"
                    onAction="#handleRetour">

                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="14"
                                         fill="WHITE"/>
                </graphic>
                <text>Retour Menu</text>
            </Button>

            <Button styleClass="menu-btn"
                    maxWidth="Infinity"
                    onAction="#handleDashboard">

                <graphic>
                    <FontAwesomeIconView glyphName="CALENDAR"
                                         size="14"
                                         fill="WHITE"/>
                </graphic>
                <text>Mes Séances</text>
            </Button>

        </VBox>
    </left>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <Label text="Séances disponibles"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- USER CHIP -->

            <HBox spacing="10"
                  alignment="CENTER"
                  styleClass="user-chip">

                <ImageView fx:id="userImageView"
                           fitWidth="30"
                           fitHeight="30"
                           preserveRatio="true"/>

                <Label fx:id="userNameLabel"
                       text="Utilisateur"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>

        <VBox spacing="30"
              alignment="TOP_CENTER"
              styleClass="content-wrapper">

            <!-- ===== TITLE + SEARCH ===== -->
            <HBox alignment="CENTER_LEFT"
                  spacing="20"
                  prefWidth="1000">

                <Label text="Liste des Séances"
                       styleClass="section-title-accent"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search avec icône -->
                <HBox alignment="CENTER_LEFT"
                      styleClass="search-container">

                    <FontAwesomeIconView glyphName="SEARCH"
                                         size="13"
                                         fill="#777"/>

                    <TextField fx:id="searchField"
                               promptText="Rechercher une séance..."
                               styleClass="search-field-pro"/>
                </HBox>

            </HBox>

            <!-- ===== CARDS CONTAINER ===== -->
            <ScrollPane fitToWidth="true"
                        styleClass="card-scroll"
                        VBox.vgrow="ALWAYS">

                <FlowPane fx:id="cardContainer"
                          hgap="25"
                          vgap="25"
                          prefWrapLength="1000"
                          alignment="TOP_LEFT"
                          styleClass="cards-container"/>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>