<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="sidebarRoot" prefWidth="230.0" spacing="15.0"
      style="-fx-background-color: #1E293B; -fx-padding: 30 15 15 15;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.SideBarController">

    <children>
        <Label text="EcoAdventure" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

        <Button onAction="#goToDashboard" maxWidth="Infinity" text="Dashboard"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToReclamations" maxWidth="Infinity" text="Réclamations"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goTogestionuser" maxWidth="Infinity" text="Gestion des utilisateurs"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToMessengerie" maxWidth="Infinity" text="Messengerie"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToProfil" maxWidth="Infinity" text="Mon Profil"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
        <Button onAction="#goToEvenementsAdmin" maxWidth="Infinity" text="Gestion Evenement" styleClass="nav-button" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
        <Button onAction="#goToStats" maxWidth="Infinity" text="📊 Dashboard Événement" styleClass="nav-button" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToEvenements" maxWidth="Infinity" text="Évènements"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
        <Button onAction="#goToReservations" maxWidth="Infinity" text="Réservations Evenements"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#openMainLayout" maxWidth="Infinity" text="➡️ Ouvrir MainLayout"
                style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
        <Button onAction="#goToPlanning"
                maxWidth="Infinity"
                text="Gestion Planning"
                style="-fx-background-color: transparent;
               -fx-text-fill: white;
               -fx-alignment: CENTER_LEFT;
               -fx-cursor: hand;"/>
        <Region VBox.vgrow="ALWAYS" />

        <Button onAction="#handleLogout" maxWidth="Infinity" text="🚪 Déconnexion"
                style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
    </children>
</VBox>