<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.UserReclamationController">

    <stylesheets>
        <URL value="@style_reclamation.css" />
    </stylesheets>

    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Mes Réclamations" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #143D30;"/>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="350.0" spacing="15.0" styleClass="card">
                            <children>
                                <Label text="Nouvelle Réclamation" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1e293b;"/>

                                <VBox spacing="5">
                                    <Label text="Type de problème" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                    <ComboBox fx:id="comboType" maxWidth="Infinity" promptText="Choisir un type..."/>
                                </VBox>

                                <VBox spacing="5">
                                    <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                                    <TextArea fx:id="txtContenu" prefHeight="200.0" promptText="Détaillez votre demande..." wrapText="true"/>
                                </VBox>

                                <HBox spacing="10">
                                    <Button fx:id="btnEnvoyer" onAction="#handleEnvoyer" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="Envoyer" styleClass="btn-primary" style="-fx-background-color: #143D30; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>
                                    <Button fx:id="btnModifier" disable="true" onAction="#handleUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="Modifier" styleClass="btn-primary" style="-fx-background-color: #F37021; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                                </HBox>
                                <Button onAction="#clearFields" maxWidth="Infinity" text="Annuler" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 10; -fx-font-weight: bold;"/>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Historique de mes demandes" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1e293b;"/>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleDelete" text="🗑 Supprimer" style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15;"/>
                                    </children>
                                </HBox>

                                <TableView fx:id="tableMyRecs" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMyType" text="Type" prefWidth="120"/>
                                        <TableColumn fx:id="colMyStatut" text="Statut" prefWidth="120"/>
                                        <TableColumn fx:id="colMyContenu" text="Contenu" prefWidth="250"/>
                                        <TableColumn fx:id="colMyReponse" text="Réponse Admin" prefWidth="200"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>