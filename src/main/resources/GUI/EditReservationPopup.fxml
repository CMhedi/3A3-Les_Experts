<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controllers.EditReservationPopupController"
           stylesheets="@edit_reservation_popup.css"
           styleClass="overlay">

    <VBox styleClass="dialog" spacing="18">

        <!-- ===== Header (green gradient) ===== -->
        <HBox styleClass="header" alignment="CENTER_LEFT">
            <Label text="Modifier Réservation" styleClass="header-title"/>
        </HBox>

        <!-- ===== Card ===== -->
        <VBox styleClass="card" spacing="18">
            <padding>
                <Insets top="22" right="22" bottom="22" left="22"/>
            </padding>

            <GridPane hgap="22" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Row 1 -->
                <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="Date Réservation" styleClass="field-label"/>
                    <DatePicker fx:id="dpDate" styleClass="field"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="Statut" styleClass="field-label"/>
                    <ComboBox fx:id="cbStatut" promptText="Choisir..." styleClass="field"/>
                </VBox>

                <!-- Row 2 -->
                <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <Label text="Participants" styleClass="field-label"/>
                    <Spinner fx:id="spNbPersonnes" styleClass="field"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <Label text="Numéro De Resérvation" styleClass="field-label"/>
                    <TextField fx:id="tfIdReservation" editable="false" styleClass="field read-only"/>
                </VBox>

                <!-- Row 3 -->
                <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0">
                    <Label text="ID Utilisateur" styleClass="field-label"/>
                    <TextField fx:id="tfIdUser" editable="false" styleClass="field read-only"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <Label text="Numero De Recu Activité" styleClass="field-label"/>
                    <TextField fx:id="tfIdActivite" editable="false" styleClass="field read-only"/>
                </VBox>
            </GridPane>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="18" styleClass="buttons">
                <Button text="ENREGISTRER" styleClass="btn-save" onAction="#onSave"/>
                <Button text="ANNULER" styleClass="btn-cancel" onAction="#onCancel"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
