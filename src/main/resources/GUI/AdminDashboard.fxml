<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AdminDashboard1Controller">
    <stylesheets>
        <URL value="@styleuser.css" />
    </stylesheets>

    <content>
        <VBox spacing="25" styleClass="main-container" style="-fx-background-color: #f8f9fb; -fx-padding: 30;">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Tableau de Bord EcoAdventure" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #143D30;"/>
                        <Label text="Voici un résumé de l'activité aujourd'hui." style="-fx-text-fill: #6b7280; -fx-font-size: 14;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <GridPane hgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <children>
                        <VBox styleClass="stat-card" GridPane.columnIndex="0">
                            <Label text="Chiffre d'Affaires" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            <Label fx:id="lblRevenue" text="0.00 DT" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #143D30;"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="1">
                            <Label text="Packs Actifs" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            <Label fx:id="lblPacks" text="0" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #F37021;"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="2">
                            <Label text="Réservations" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            <Label fx:id="lblReservations" text="0" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #143D30;"/>
                        </VBox>
                        <VBox styleClass="stat-card" GridPane.columnIndex="3">
                            <Label text="Réclamations (Attente)" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                            <Label fx:id="lblClaims" text="0" style="-fx-font-size: 24; -fx-font-weight: 900; -fx-text-fill: #ef4444;"/>
                        </VBox>
                    </children>
                </GridPane>

                <HBox spacing="25">
                    <children>
                        <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                            <Label text="Performance des Inscriptions" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                            <AreaChart fx:id="revenueChart" prefHeight="300">
                                <xAxis><CategoryAxis label="Date"/></xAxis>
                                <yAxis><NumberAxis label="Montant (DT)"/></yAxis>
                            </AreaChart>
                        </VBox>

                        <VBox prefWidth="350" styleClass="stat-card">
                            <Label text="Répartition des Rôles" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                            <PieChart fx:id="rolePieChart" prefHeight="300"/>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="25" VBox.vgrow="ALWAYS">
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card" spacing="10">
                        <Label text="Dernières Inscriptions" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                        <TableView fx:id="tableRecentInscriptions" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colUser" text="Utilisateur" prefWidth="120"/>
                                <TableColumn fx:id="colPack" text="Pack" prefWidth="120"/>
                                <TableColumn fx:id="colMontant" text="Montant" prefWidth="80"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox prefWidth="400" spacing="15" styleClass="stat-card" style="-fx-background-color: #143D30; -fx-background-radius: 15; -fx-padding: 20;">
                        <Label text="Aperçu des Réservations" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18;"/>

                        <VBox spacing="5" VBox.vgrow="ALWAYS">
                            <Label text="🏃 Activités" style="-fx-text-fill: #adb5bd; -fx-font-size: 12;"/>
                            <TableView fx:id="miniTableActivite" prefHeight="120" styleClass="mini-table">
                                <columns>
                                    <TableColumn fx:id="colMiniActNom" text="Activité" prefWidth="100"/>
                                    <TableColumn fx:id="colMiniActStatut" text="Statut" prefWidth="80"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox spacing="5" VBox.vgrow="ALWAYS">
                            <Label text="📅 Événements" style="-fx-text-fill: #adb5bd; -fx-font-size: 12;"/>
                            <TableView fx:id="miniTableEvenement" prefHeight="120" styleClass="mini-table">
                                <columns>
                                    <TableColumn fx:id="colMiniEvtTitre" text="Événement" prefWidth="100"/>
                                    <TableColumn fx:id="colMiniEvtStatut" text="Statut" prefWidth="80"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>

                        <Button text="Gérer Tout" maxWidth="Infinity" style="-fx-background-color: #F37021; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>