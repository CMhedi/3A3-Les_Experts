<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="sidebarRoot"
      prefWidth="230.0" spacing="15.0"
      style="-fx-background-color: #143D30; -fx-padding: 30 15 15 15;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.SideBarUserController">

    <children>
        <Label text="EcoAdventure"
               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-padding: 0 0 30 0;"/>

        <Button onAction="#goToProfil" maxWidth="Infinity" text=" Mon Profil"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <!-- ✅ NEW BUTTON -->
        <Button onAction="#goToPacks" maxWidth="Infinity" text=" 🧭 Packs &amp; Inscription"
                style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-background-radius: 10;"/>

        <Button onAction="#goToMyReclamations" maxWidth="Infinity" text=" Réclamations"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToMessengerie" maxWidth="Infinity" text="Messengerie"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToNews" maxWidth="Infinity" text=" News"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToEvenements" maxWidth="Infinity" text=" Évènements"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToSeancesDisponibles" maxWidth="Infinity" text=" Séances disponibles"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Button onAction="#goToNutrition" maxWidth="Infinity" text=" 🍎 Nutrition &amp; Performance"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button onAction="#handleLogout" maxWidth="Infinity" text=" Déconnexion"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
    </children>
</VBox>