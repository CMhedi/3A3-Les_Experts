<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.scene.shape.Circle?>

<?import javafx.scene.effect.DropShadow?>
<VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.UserReclamationController">
    <stylesheets>
        <URL value="@style_reclamation.css" />
    </stylesheets>
        <children>
            <VBox alignment="CENTER" spacing="8">
                <Label text="Centre d'Assistance" style="-fx-font-size: 36; -fx-font-weight: 800; -fx-text-fill: #143D30;"/>
                <Label text="Une question ? Une remarque ? Notre équipe est à votre écoute." style="-fx-text-fill: #64748b; -fx-font-size: 15;"/>
            </VBox>

            <VBox maxWidth="550.0" spacing="25.0" styleClass="main-card">
                <children>
                    <VBox spacing="10">
                        <Label text="Type de réclamation" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14;"/>
                        <ComboBox fx:id="comboType" promptText="Choisir une catégorie..." maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="10">
                        <HBox alignment="BOTTOM_LEFT">
                            <Label text="Détails du message" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblSentiment" text="😐" style="-fx-font-size: 35;" />
                        </HBox>

                        <TextArea fx:id="txtContenu" prefHeight="180.0" promptText="Décrivez votre situation ici..." wrapText="true" />

                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <ProgressBar fx:id="progressChar" progress="0.0" HBox.hgrow="ALWAYS" prefHeight="8.0" styleClass="mini-progress"/>
                            <Label fx:id="lblCharCount" text="0/1000" style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <Label fx:id="lblAutoReply" visible="false" managed="false" styleClass="auto-reply-box" />

                    <Button fx:id="btnEnvoyer" onAction="#handleEnvoyer" text="Envoyer mon message" maxWidth="Infinity" styleClass="btn-submit" />
                </children>
            </VBox>

            <Button onAction="#switchToList" text="Consulter l'historique de mes demandes"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand; -fx-underline: false;"/>
        </children>
    </VBox>
