<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="0.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.UserAddController">
    <children>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER" spacing="0" style="-fx-padding: 40;">
                    <children>
                        <VBox alignment="TOP_CENTER" maxWidth="750" spacing="30" style="-fx-background-color: white; -fx-padding: 50; -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                            <children>
                                <!-- Header Section -->
                                <VBox alignment="CENTER" spacing="15">
                                    <children>
                                        <Label style="-fx-background-color: #ECFDF5; -fx-padding: 15; -fx-background-radius: 20; -fx-text-fill: #10B981; -fx-font-size: 24;" text="👤+" />
                                        <VBox alignment="CENTER" spacing="5">
                                            <children>
                                                <Label style="-fx-font-weight: 900; -fx-font-size: 32; -fx-text-fill: #111827;" text="Nouveau Membre" />
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 14;" text="Ajoutez un nouvel utilisateur à la plateforme EcoAdventure" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Section: Informations Personnelles -->
                                <VBox spacing="20">
                                    <children>
                                        <Label style="-fx-text-fill: #10B981; -fx-font-weight: 900; -fx-font-size: 13; -fx-letter-spacing: 1;" text="INFORMATIONS PERSONNELLES" />
                                        <Separator />
                                        <GridPane hgap="25" vgap="20">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Prénom" />
                                                    <TextField fx:id="txtPrenom" prefHeight="55" promptText="Ex: Ahmed" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorPrenom" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Nom" />
                                                    <TextField fx:id="txtNom" prefHeight="55" promptText="Ex: Lahmer" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorNom" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Âge" />
                                                    <TextField fx:id="txtAge" prefHeight="55" promptText="Ex: 25" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorAge" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Numéro de Téléphone" />
                                                    <TextField fx:id="txtPhone" prefHeight="55" promptText="22 123 456" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                </VBox>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- Section: Accès & Sécurité -->
                                <VBox spacing="20">
                                    <children>
                                        <Label style="-fx-text-fill: #10B981; -fx-font-weight: 900; -fx-font-size: 13; -fx-letter-spacing: 1;" text="ACCÈS &amp; SÉCURITÉ" />
                                        <Separator />
                                        <GridPane hgap="25" vgap="20">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Adresse Email" />
                                                    <TextField fx:id="txtEmail" prefHeight="55" promptText="exemple@mail.com" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorEmail" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Rôle Système" />
                                                    <ComboBox fx:id="comboRole" maxWidth="Infinity" prefHeight="55" promptText="USER_SIMPLE" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-border-color: #E2E8F0;" />
                                                </VBox>
                                            </children>
                                        </GridPane>
                                        <VBox spacing="8">
                                            <children>
                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Mot de passe initial" />
                                                <PasswordField fx:id="txtPassword" prefHeight="55" promptText="Entrez un mot de passe sécurisé" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                <Label fx:id="errorPassword" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <!-- Conditional Section for Coach -->
                                <VBox fx:id="coachFieldsContainer" spacing="20">
                                    <children>
                                        <Label style="-fx-text-fill: #10B981; -fx-font-weight: 900; -fx-font-size: 13; -fx-letter-spacing: 1;" text="DÉTAILS COACH" />
                                        <Separator />
                                        <GridPane hgap="25" vgap="20">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
                                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="8" GridPane.columnIndex="0">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Spécialité" />
                                                    <ComboBox fx:id="comboSpecialite" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorSpec" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="1">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Disponibilité" />
                                                    <ComboBox fx:id="comboDispo" maxWidth="Infinity" prefHeight="50" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorDispo" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                                <VBox spacing="8" GridPane.columnIndex="2">
                                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Expérience" />
                                                    <TextField fx:id="txtExperience" prefHeight="50" promptText="Années" style="-fx-background-color: #F8FAFC; -fx-background-radius: 12; -fx-padding: 0 15; -fx-border-color: #E2E8F0;" />
                                                    <Label fx:id="errorExperience" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;" visible="false" />
                                                </VBox>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- Action Buttons -->
                                <VBox alignment="CENTER" spacing="15">
                                    <children>
                                        <Button fx:id="btnEnregistrer" maxWidth="Infinity" onAction="#handleAdd" prefHeight="60" style="-fx-background-color: #4D7C44; -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 16; -fx-background-radius: 15; -fx-cursor: hand;" text="✓ Créer le compte utilisateur" />
                                        <Button maxWidth="Infinity" onAction="#handleCancel" prefHeight="60" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 15; -fx-cursor: hand;" text="Annuler et retour" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>