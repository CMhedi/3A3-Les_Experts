<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.UserAddController" style="-fx-background-color: #f1f5f9;">
    <children>
        <HBox spacing="10" style="-fx-background-color: #1B4D3E; -fx-padding: 30;" alignment="CENTER_LEFT">
            <children>
                <VBox spacing="5">
                    <Label text="Inscription Nouveau Membre" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="EcoAdventure : Système de gestion des accès" style="-fx-text-fill: #A7F3D0; -fx-font-size: 13;"/>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="25" style="-fx-padding: 30;">
                    <children>
                        <VBox spacing="25" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                            <children>
                                <HBox spacing="20">
                                    <children>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="NOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                            <TextField fx:id="txtNom" promptText="Saisir le nom" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                            <Label fx:id="errorNom" text="⚠️ Nom obligatoire" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="PRÉNOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                            <TextField fx:id="txtPrenom" promptText="Saisir le prénom" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                            <Label fx:id="errorPrenom" text="⚠️ Prénom obligatoire" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="20">
                                    <children>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="EMAIL" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                            <TextField fx:id="txtEmail" promptText="email@ecoadventure.com" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                            <Label fx:id="errorEmail" text="⚠️ Email invalide" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label text="RÔLE" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                            <ComboBox fx:id="comboRole" maxWidth="Infinity" prefHeight="45.0" promptText="Choisir un rôle" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox fx:id="coachFieldsContainer" spacing="15" style="-fx-background-color: #f0fdf4; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #dcfce7;">
                                    <children>
                                        <Label text="⭐ Détails Professionnels (Coach)" style="-fx-font-weight: bold; -fx-text-fill: #1B4D3E;"/>
                                        <HBox spacing="15">
                                            <children>
                                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                    <Label text="Âge" style="-fx-text-fill: #475569;"/>
                                                    <TextField fx:id="txtAge" promptText="Ex: 28" prefHeight="40"/>
                                                    <Label fx:id="errorAge" text="⚠️ 18-40 ans" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                                </VBox>
                                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                    <Label text="Expérience" style="-fx-text-fill: #475569;" />
                                                    <TextField fx:id="txtExperience" promptText="Années" prefHeight="40" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-text-fill: #1e293b;"/>
                                                    <Label fx:id="errorExperience" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <HBox spacing="15">
                                            <children>
                                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                    <Label text="Spécialité" style="-fx-text-fill: #475569;"/>
                                                    <ComboBox fx:id="comboSpecialite" prefWidth="350.0" promptText="Spécialité" styleClass="modern-combo" />
                                                    <Label fx:id="errorSpec" text="⚠️ Requis" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                                </VBox>
                                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                                    <Label text="Disponibilité" style="-fx-text-fill: #475569;"/>
                                                    <ComboBox fx:id="comboDispo" prefWidth="350.0" promptText="Disponibilité" styleClass="modern-combo" />
                                                    <Label fx:id="errorDispo" text="⚠️ Requis" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="5">
                                    <Label text="MOT DE PASSE" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #1B4D3E;"/>
                                    <PasswordField fx:id="txtPassword" prefHeight="45" style="-fx-background-color: #f0fdf4; -fx-border-color: #1B4D3E; -fx-border-radius: 8;"/>
                                    <Label fx:id="errorPassword" text="⚠️ Minimum 6 caractères" textFill="RED" visible="false" managed="false" style="-fx-font-size: 10;"/>
                                </VBox>

                                <HBox spacing="15" alignment="CENTER_RIGHT">
                                    <Button text="ANNULER" onAction="#handleCancel" prefHeight="45" prefWidth="120" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                                    <Button fx:id="btnEnregistrer" text="CONFIRMER L'AJOUT" onAction="#handleAdd" prefHeight="45" prefWidth="200" style="-fx-background-color: #1B4D3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>