<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootPane" prefHeight="750.0" prefWidth="1100.0" styleClass="main-container" stylesheets="@style_admin.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.AdminReclamationController">
    <!-- Hidden Stats to keep Controller working -->
    <Label fx:id="lblPending" visible="false" managed="false"/>
    <Label fx:id="lblProcessing" visible="false" managed="false"/>
    <Label fx:id="lblDone" visible="false" managed="false"/>

    <VBox spacing="30.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="40.0" styleClass="content-card">
        <children>
            <!-- Title Section -->
            <VBox spacing="8.0">
                <children>
                    <Label styleClass="header-title" text="Mes Réclamations" />
                    <Label styleClass="header-subtitle" text="Suivez l'état de vos demandes en temps réel" />
                </children>
            </VBox>
            
            <!-- Search Box -->
            <HBox alignment="CENTER_LEFT">
                <children>
                    <HBox alignment="CENTER_LEFT" styleClass="search-box">
                        <children>
                            <Label text="🔍" style="-fx-text-fill: #94A3B8; -fx-padding: 0 5 0 0;"/>
                            <TextField fx:id="txtSearch" promptText="Rechercher par type, date..." styleClass="search-field" />
                        </children>
                    </HBox>
                </children>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tableReclamations" VBox.vgrow="ALWAYS" styleClass="custom-table">
                <columns>
                    <TableColumn fx:id="colType" prefWidth="220.0" text="TYPE DE PLAINTE" />
                    <TableColumn fx:id="colDate" prefWidth="200.0" text="DATE DE CRÉATION" />
                    <TableColumn fx:id="colStatut" prefWidth="180.0" text="ÉTAT" />
                    <TableColumn fx:id="colPriority" prefWidth="150.0" text="PRIORITÉ" />
                    <TableColumn fx:id="colActions" prefWidth="250.0" text="ACTIONS" />
                </columns>
            </TableView>
        </children>
    </VBox>
</AnchorPane>