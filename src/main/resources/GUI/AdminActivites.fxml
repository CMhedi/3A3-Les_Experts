<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AdminActivitesController"
            styleClass="root"
            stylesheets="@/css/app.css">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <StackPane maxWidth="270" minWidth="270" prefWidth="270" styleClass="sidebar">

            <Region styleClass="sidebar-overlay"/>

            <VBox spacing="14" styleClass="sidebar-content">

                <!-- Brand -->
                <VBox spacing="2">
                    <Label text="EcoAdventure" styleClass="brand"/>
                    <Label text="Admin Panel" styleClass="brand-sub" />
                </VBox>

                <Region styleClass="sep"/>

                <!-- Navigation -->
                <VBox spacing="6">


                    <Button text="MainLayout"
                            styleClass="nav-item"
                            onAction="#goToUserSeances"/>
                    <Button text="Activités"
                            styleClass="nav-item active-nav"/>

                    <Button text="Réservations"
                            styleClass="nav-item"
                            onAction="#openReservations"/>


                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Déconnexion"
                        styleClass="nav-item"
                        />

            </VBox>
        </StackPane>
    </left>

    <!-- ================= TOPBAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding>
                <Insets top="14" bottom="14" left="18" right="18"/>
            </padding>

            <VBox spacing="2">
                <Label text="Gestion des Activités" styleClass="title"/>
                <Label text="Administration complète des activités" styleClass="subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="En ligne" styleClass="pill"/>
                <Button text="Admin" styleClass="btn-secondary"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <VBox spacing="20" styleClass="page">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- KPI CARDS -->
            <HBox spacing="20">

                <VBox spacing="6" alignment="CENTER" styleClass="card">
                    <Label text="Total Activités" styleClass="subtitle"/>
                    <Label fx:id="lblTotalAct" text="-" styleClass="title"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER" styleClass="card">
                    <Label text="Actives" styleClass="subtitle"/>
                    <Label fx:id="lblActiveAct" text="-" styleClass="title"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER" styleClass="card">
                    <Label text="Prix moyen" styleClass="subtitle"/>
                    <Label fx:id="lblAvgPrice" text="-" styleClass="title"/>
                </VBox>

            </HBox>

            <!-- TABLE CARD -->
            <VBox spacing="15" styleClass="card content-card" VBox.vgrow="ALWAYS">

                <Label text="Liste des Activités" styleClass="title"/>

                <TableView fx:id="tableActivites"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>
                        <TableColumn fx:id="colDate" text="Date"/>
                        <TableColumn fx:id="colNom" text="Nom"/>
                        <TableColumn fx:id="colType" text="Type"/>
                        <TableColumn fx:id="colCategorie" text="Catégorie"/>
                        <TableColumn fx:id="colNiveau" text="Niveau"/>
                        <TableColumn fx:id="colStatut" text="Statut"/>
                        <TableColumn fx:id="colPrix" text="Prix"/>
                        <TableColumn fx:id="colImage" text="Image URL"/>
                    </columns>

                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button text="Modifier"
                            styleClass="btn-primary"
                            onAction="#modifierActivite"/>

                    <Button text="Supprimer"
                            styleClass="btn-danger"
                            onAction="#supprimerActivite"/>

                    <Button text="Statistique"
                            styleClass="btn-secondary"
                            onAction="#openstat"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>