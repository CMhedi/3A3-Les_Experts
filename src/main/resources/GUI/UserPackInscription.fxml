<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.UserPackInscriptionController"
            stylesheets="@user_pack.css"
            styleClass="page">

    <top>
        <VBox spacing="6" styleClass="topbar">
            <padding>
                <Insets top="18" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Confirmation d'inscription" styleClass="title"/>
            <Label text="Vérifie les infos, puis valide." styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="card">
            <!-- ✅ FIX: padding يجب يكون Insets -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="170" prefWidth="200"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Utilisateur :" styleClass="k"/>
                <Label fx:id="lblUser" GridPane.columnIndex="1" styleClass="v"/>

                <Label text="Pack :" GridPane.rowIndex="1" styleClass="k"/>
                <Label fx:id="lblPack" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="v"/>

                <Label text="Prix (après réduction) :" GridPane.rowIndex="2" styleClass="k"/>
                <Label fx:id="lblPrix" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="v"/>

                <Label text="Déjà inscrits :" GridPane.rowIndex="3" styleClass="k"/>
                <Label fx:id="lblInscrits" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="v"/>

                <Label text="Capacité max :" GridPane.rowIndex="4" styleClass="k"/>
                <Label fx:id="lblCapacite" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="v"/>

                <Label text="Nb personnes (toi + groupe) :" GridPane.rowIndex="5" styleClass="k"/>
                <Spinner fx:id="spNb" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="160"/>
            </GridPane>

            <Separator/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label text="Total :" styleClass="k"/>
                <Label fx:id="lblTotal" styleClass="total"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="⬅ Retour" onAction="#backToList" styleClass="btn-secondary"/>
                <Button text="✅ Valider" onAction="#validate" styleClass="btn-primary"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>