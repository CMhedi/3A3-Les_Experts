<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="0.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.UserUpdateController" style="-fx-background-color: #f1f5f9;">
    <children>
        <HBox spacing="10" style="-fx-background-color: #143d30; -fx-padding: 30;" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Modification du Profil" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="EcoAdventure : Édition des paramètres" style="-fx-text-fill: #A7F3D0; -fx-font-size: 13;"/>
            </VBox>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="25" style="-fx-padding: 30;">
                    <VBox spacing="25" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">

                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="NOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                <TextField fx:id="txtNom" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                <Label fx:id="errorNom" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="PRÉNOM" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                <TextField fx:id="txtPrenom" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                <Label fx:id="errorPrenom" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="EMAIL" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                <TextField fx:id="txtEmail" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                                <Label fx:id="errorEmail" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="RÔLE" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #64748b;"/>
                                <ComboBox fx:id="comboRole" maxWidth="Infinity" prefHeight="45" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;"/>
                            </VBox>
                        </HBox>

                        <VBox fx:id="coachFieldsContainer" spacing="15" style="-fx-background-color: #f0fdf4; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #dcfce7;">
                            <Label text="⭐ Détails Professionnels (Coach)" style="-fx-font-weight: bold; -fx-text-fill: #1B4D3E;"/>
                            <HBox spacing="15">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Âge" style="-fx-text-fill: #475569;"/>
                                    <TextField fx:id="txtAge" prefHeight="40"/>
                                    <Label fx:id="errorAge" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Expérience" style="-fx-text-fill: #475569;" />
                                    <TextField fx:id="txtExperience" prefHeight="40"/>
                                    <Label fx:id="errorExperience" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="15">
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Spécialité" style="-fx-text-fill: #475569;"/>
                                    <ComboBox fx:id="comboSpecialite" prefWidth="350.0" promptText="Spécialité" styleClass="modern-combo" />
                                    <Label fx:id="errorSpec" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label text="Disponibilité" style="-fx-text-fill: #475569;"/>
                                    <ComboBox fx:id="comboDispo" prefWidth="350.0" promptText="Disponibilité" styleClass="modern-combo" />
                                    <Label fx:id="errorDispo" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="MOT DE PASSE" style="-fx-font-weight: 800; -fx-font-size: 11; -fx-text-fill: #1B4D3E;"/>
                            <StackPane alignment="CENTER_RIGHT">
                                <children>
                                    <PasswordField fx:id="txtPassword" prefHeight="45" style="-fx-background-color: #f0fdf4; -fx-border-color: #1B4D3E; -fx-border-radius: 8; -fx-padding: 0 40 0 10;"/>

                                    <TextField fx:id="txtPasswordVisible" visible="false" managed="false" prefHeight="45" style="-fx-background-color: #f0fdf4; -fx-border-color: #1B4D3E; -fx-border-radius: 8; -fx-padding: 0 40 0 10;"/>

                                    <Button fx:id="btnShowPass" onAction="#togglePassword" style="-fx-background-color: transparent; -fx-cursor: hand;" text="👁️">
                                        <StackPane.margin>
                                            <Insets right="10.0" />
                                        </StackPane.margin>
                                    </Button>
                                </children>
                            </StackPane>
                            <Label fx:id="errorPassword" visible="false" managed="false" style="-fx-text-fill: #ef4444; -fx-font-size: 10;"/>
                        </VBox>
                        <HBox spacing="15" alignment="CENTER_RIGHT">
                            <Button text="ANNULER" onAction="#handleCancel" prefHeight="45" prefWidth="120" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                            <Button fx:id="btnUpdate" text="ENREGISTRER" onAction="#handleUpdate" prefHeight="45" prefWidth="200" style="-fx-background-color: #1B4D3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>