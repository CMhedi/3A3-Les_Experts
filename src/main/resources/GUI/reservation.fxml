<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.ReservationController"
            stylesheets="@reservation.css"
            styleClass="root">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <Label text="Espace Coach" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Coach" onAction="#goToUserSeances" styleClass="user-pill"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="14" styleClass="sidebar">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Eco" styleClass="brand"/>
                <Label text="Adventure" styleClass="brand-accent"/>
            </HBox>

            <Separator styleClass="sep"/>

            <Button text="← Retour Menu" styleClass="side-btn" onAction="#goToUserSeances"/>
            <Button text="Réservations Activités" styleClass="side-btn active"/>
            <Button text="Activités" styleClass="side-btn" onAction="#goActivites"/>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="18" styleClass="content-wrap">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <!-- KPI CARDS -->
            <HBox spacing="18" alignment="CENTER" styleClass="kpi-row">
                <VBox alignment="CENTER" spacing="6" styleClass="kpi-card">
                    <Label text="Total Réservations" styleClass="kpi-label"/>
                    <Label fx:id="lblTotal" text="0" styleClass="kpi-value"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" styleClass="kpi-card">
                    <Label text="Tickets générés" styleClass="kpi-label"/>
                    <Label fx:id="lblTickets" text="0" styleClass="kpi-value"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" styleClass="kpi-card">
                    <Label text="Check-in" styleClass="kpi-label"/>
                    <Label fx:id="lblChecked" text="0" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <!-- TABLE CARD -->
            <VBox spacing="12" styleClass="table-card">
                <Label text="Mes Réservations" styleClass="section-title"/>

                <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="130"/>
                        <TableColumn fx:id="colNb" text="Participants" prefWidth="120"/>
                        <TableColumn fx:id="colToken" text="Ticket Token" prefWidth="220"/>
                        <TableColumn fx:id="colGeneratedAt" text="Généré le" prefWidth="160"/>
                        <TableColumn fx:id="colCheckedIn" text="Check-in" prefWidth="110"/>
                        <TableColumn fx:id="colCheckinTime" text="Heure check-in" prefWidth="160"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button text="Rafraîchir" styleClass="btn-secondary" onAction="#refreshTable"/>
                    <Button text="Modifier" styleClass="btn-primary" onAction="#modifierReservation"/>
                    <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerReservation"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>