<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.ReservationController"
            stylesheets="@reservation.css">

    <!-- ============ LEFT SIDEBAR ============ -->
    <left>
        <VBox spacing="15" styleClass="sidebar">
            <Label text="EcoAdventure" styleClass="logo"/>

            <Button text="Tableau de bord" styleClass="sidebar-btn"/>
            <Button text="Activités" styleClass="sidebar-btn" onAction="#goActivites"/>
            <Button text="Réservations" styleClass="sidebar-btn active"/>
            <Button text="Événements" styleClass="sidebar-btn"/>
            <Button text="Utilisateurs" styleClass="sidebar-btn"/>
        </VBox>
    </left>

    <!-- ============ TOP NAVBAR ============ -->
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="topbar">
            <Button text="Admin"
                    onAction="#goToUserSeances"
                    styleClass="admin-name"/>

        </HBox>
    </top>

    <!-- ============ CENTER CONTENT ============ -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <Label text="Réservations" styleClass="page-title"/>

            <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                  <!--  <TableColumn fx:id="colId" text="ID" prefWidth="70"/> -->
                  <!--  <TableColumn fx:id="colDate" text="Date" prefWidth="130"/>-->
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="140"/>
                    <TableColumn fx:id="colNb" text="Participants" prefWidth="130"/>
                    <TableColumn fx:id="colUser" text="ID User" prefWidth="1"/>
                    <TableColumn fx:id="colActivite" text="Numéro De Recu Activité" prefWidth="180"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button text="Modifier"
                        styleClass="btn-primary"
                        onAction="#modifierReservation"/>

                <Button text="Supprimer"
                        styleClass="btn-danger"
                        onAction="#supprimerReservation"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
