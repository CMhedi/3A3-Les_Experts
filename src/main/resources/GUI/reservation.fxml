<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ReservationController"
            styleClass="root"
            stylesheets="@/css/app.css, @reservation.css">

    <!-- ================= TOPBAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding>
                <Insets top="14" bottom="14" left="18" right="18"/>
            </padding>

            <VBox spacing="2">
                <Label text="Gestion des Réservations" styleClass="title"/>
                <Label text="Réservations d’activités (base ecoadventure)" styleClass="subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Admin" styleClass="pill"/>
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <VBox spacing="20" styleClass="page">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- KPI CARDS -->
            <HBox spacing="20">
                <VBox spacing="6" alignment="CENTER" styleClass="card kpi-card">
                    <Label text="Total Réservations" styleClass="subtitle"/>
                    <Label fx:id="lblTotal" text="0" styleClass="title"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER" styleClass="card kpi-card">
                    <Label text="Places (Σ participants)" styleClass="subtitle"/>
                    <Label fx:id="lblTickets" text="0" styleClass="title"/>
                </VBox>

                <VBox spacing="6" alignment="CENTER" styleClass="card kpi-card">
                    <Label text="Scans ticket (SCANNEE)" styleClass="subtitle"/>
                    <Label fx:id="lblChecked" text="0" styleClass="title"/>
                </VBox>
            </HBox>

            <!-- TABLE CARD -->
            <VBox spacing="15" styleClass="card content-card" VBox.vgrow="ALWAYS">

                <Label text="Liste des Réservations" styleClass="title"/>

                <TableView fx:id="tableReservation"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                        <TableColumn fx:id="colNb" text="Participants" prefWidth="100"/>
                        <TableColumn fx:id="colDate" text="Date réservation" prefWidth="150"/>
                        <TableColumn fx:id="colVille" text="Ville" prefWidth="110"/>
                        <TableColumn fx:id="colActivite" text="Activité" prefWidth="180"/>
                        <TableColumn fx:id="colUser" text="Utilisateur" prefWidth="160"/>
                    </columns>

                </TableView>

                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Rafraîchir" styleClass="btn-secondary" onAction="#refreshTable"/>
                    <Button text="Modifier" styleClass="btn-primary" onAction="#modifierReservation"/>
                    <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerReservation"/>
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>