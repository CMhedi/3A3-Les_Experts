<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.NewsController" style="-fx-padding: 20; -fx-background-color: white;">

    <Label text="Actualités Sport &amp; Santé" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

    <HBox spacing="10" alignment="CENTER">
        <ComboBox fx:id="comboCategory" promptText="Catégorie" style="-fx-background-radius: 15;"/>
        <Button fx:id="btnRefresh" text="Actualiser" onAction="#loadNews"
                style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-background-radius: 15;"/>
    </HBox>

    <ListView fx:id="newsListView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-color: #DCDDE1;"/>

    <ProgressIndicator fx:id="loader" visible="false"/>
</VBox>