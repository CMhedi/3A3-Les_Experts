<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.RecuReservationController"
            stylesheets="@recuReserevation.css"
            styleClass="main-bg">

    <children>

        <StackPane AnchorPane.topAnchor="0"
                   AnchorPane.bottomAnchor="0"
                   AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0">

            <VBox spacing="20"
                  alignment="CENTER"
                  styleClass="receipt-card">

                <padding>
                    <Insets top="35" right="40" bottom="35" left="40"/>
                </padding>

                <Label text="REÇU DE RÉSERVATION"
                       styleClass="title-label"/>

                <Separator styleClass="separator-modern"/>

                <VBox spacing="12"
                      alignment="CENTER_LEFT"
                      styleClass="receipt-content">

                    <Label fx:id="lblId" styleClass="receipt-highlight"/>
                    <Label fx:id="lblStatut" styleClass="receipt-status"/>
                    <Label fx:id="lblNb" styleClass="receipt-text"/>
                    <Label fx:id="lblUser" styleClass="receipt-text"/>
                    <Label fx:id="lblActivite" styleClass="receipt-text"/>

                    <!-- NEW -->
                    <Label fx:id="lblToken" styleClass="receipt-text" wrapText="true"/>
                    <ImageView fx:id="qrView" fitWidth="220" fitHeight="220" preserveRatio="true"/>

                </VBox>

                <Separator styleClass="separator-modern"/>

                <HBox alignment="CENTER" spacing="12">

                    <!-- NEW -->
                    <Button text="🎟 Générer Ticket QR"
                            onAction="#genererQr"
                            styleClass="primary-button"/>

                    <Button text="Fermer"
                            onAction="#fermer"
                            styleClass="secondary-button"/>

                </HBox>

            </VBox>

        </StackPane>

    </children>
</AnchorPane>