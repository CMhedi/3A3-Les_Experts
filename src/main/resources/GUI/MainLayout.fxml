<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root"
            stylesheets="@/css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainLayoutController">

    <left>
        <StackPane maxWidth="270" minWidth="270" prefWidth="270" styleClass="sidebar">

            <Region styleClass="sidebar-overlay" />

            <VBox fx:id="sidebarContent" spacing="14" styleClass="sidebar-content">

                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-wrap">
                    <StackPane prefWidth="48" prefHeight="48" maxWidth="48" maxHeight="48" styleClass="logo-circle">
                        <ImageView fitWidth="48" fitHeight="48" preserveRatio="false" styleClass="brand-logo">
                            <image>
                                <Image url="@/assets/logo.jpg"/>
                            </image>
                            <clip>
                                <Circle centerX="24" centerY="24" radius="24"/>
                            </clip>
                        </ImageView>
                    </StackPane>
                    <VBox spacing="2">
                        <Label styleClass="brand" text="EcoAdventure" />
                        <Label styleClass="brand-sub" text="Admin Panel • 3A3" />
                    </VBox>
                </HBox>

                <VBox spacing="10" styleClass="profile-card">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="avatar">
                            <Label styleClass="avatar-text" text="E" />
                        </StackPane>
                        <VBox spacing="2">
                            <Label styleClass="profile-name" text="Eco Support" />
                            <Label styleClass="profile-role" text="Manager" />
                        </VBox>
                    </HBox>
                </VBox>

                <Region styleClass="sep" />

                <VBox spacing="6" styleClass="nav-list">
                    <Button fx:id="btnDashboard" onAction="#openDashboard" styleClass="nav-item" text="Accueil" />
                    <Button fx:id="btnInsights" onAction="#openInsights" styleClass="nav-item" text="Insights" />
                    <Button fx:id="btnPacks" onAction="#openPacks" styleClass="nav-item" text="Packs" />
                    <Button fx:id="btnInscriptions" onAction="#openInscriptions" styleClass="nav-item" text="Inscriptions" />


                    <Button fx:id="btnPackBuilder" onAction="#openPackBuilder" styleClass="nav-item" text="Pack Builder" />
                    <Button onAction="#openSideBar" styleClass="nav-item" text="⬅️ Retour Sidebar" />
                    <Button onAction="#logout" styleClass="nav-item" text="Déconnexion" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>
    </left>

    <top>
        <HBox fx:id="topbar" alignment="CENTER_LEFT" spacing="12" styleClass="topbar">
            <padding>
                <Insets bottom="14" left="18" right="18" top="14" />
            </padding>
            <VBox spacing="2">
                <Label styleClass="title" text="EcoAdventure - Admin" />
                <Label styleClass="subtitle" text="Gestion professionnelle des packs &amp; inscriptions" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label styleClass="pill" text="En ligne" />
                <Button onAction="#logout" styleClass="btn-secondary" text="Déconnexion" />
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="page">
            <VBox maxWidth="640" spacing="10" styleClass="glass content-card" alignment="CENTER">
                <Label styleClass="page-subtitle" text="Choisissez une section dans la sidebar." />
            </VBox>
        </StackPane>
    </center>

</BorderPane>