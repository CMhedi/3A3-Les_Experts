<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.TopActiviteController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e3c2f, #2e5e47);">

    <children>

        <VBox spacing="22"
              alignment="CENTER"
              AnchorPane.topAnchor="25"
              AnchorPane.leftAnchor="25"
              AnchorPane.rightAnchor="25"
              AnchorPane.bottomAnchor="25">

            <Label text="TOP 3 CLIENTS"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <!-- Podium -->
            <HBox spacing="18" alignment="BOTTOM_CENTER">

                <!-- TOP 2 -->
                <VBox fx:id="boxTop2"
                      spacing="10"
                      alignment="CENTER"
                      prefWidth="240"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 18, 0, 0, 8);">
                    <Label text="TOP 2"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>

                    <Label fx:id="t2Nom"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3c2f;"/>

                    <Label fx:id="t2Type" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t2Categorie" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t2Niveau" style="-fx-text-fill:#444;"/>

                    <Label fx:id="t2Nb"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>

                <!-- TOP 1 (bigger) -->
                <VBox fx:id="boxTop1"
                      spacing="10"
                      alignment="CENTER"
                      prefWidth="280"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.28), 22, 0, 0, 10);">
                    <Label text="TOP 1"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>

                    <Label fx:id="t1Nom"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3c2f;"/>

                    <Label fx:id="t1Type" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t1Categorie" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t1Niveau" style="-fx-text-fill:#444;"/>

                    <Label fx:id="t1Nb"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>

                <!-- TOP 3 -->
                <VBox fx:id="boxTop3"
                      spacing="10"
                      alignment="CENTER"
                      prefWidth="240"
                      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 18, 0, 0, 8);">
                    <Label text="TOP 3"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #cd7f32;"/>

                    <Label fx:id="t3Nom"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3c2f;"/>

                    <Label fx:id="t3Type" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t3Categorie" style="-fx-text-fill:#444;"/>
                    <Label fx:id="t3Niveau" style="-fx-text-fill:#444;"/>

                    <Label fx:id="t3Nb"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>

            </HBox>

            <Button text="Retour"
                    onAction="#goUserSeances"
                    style="-fx-background-color:#f4b860; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:25; -fx-padding:10 24;"/>

        </VBox>

    </children>
</AnchorPane>