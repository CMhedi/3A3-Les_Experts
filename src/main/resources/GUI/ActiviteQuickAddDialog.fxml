<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ActiviteQuickAddDialogController"
      spacing="14" style="-fx-padding: 20; -fx-min-width: 440;">
    <Label fx:id="lblTitle" text="Nouvelle activité" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #143D30;"/>
    <Label fx:id="lblSubtitle" text="Enregistrement via ActiviteService." wrapText="true"
           style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
    <Label fx:id="lblDbHint" managed="false" visible="false" wrapText="true"
           style="-fx-text-fill: #0f766e; -fx-font-size: 11.5; -fx-font-weight: 700;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>
        <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Label text="Nom *"/>
            <TextField fx:id="tfNom" promptText="Nom de l'activité"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="0">
            <Label text="Type *"/>
            <ComboBox fx:id="cbType" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <Label text="Catégorie *"/>
            <ComboBox fx:id="cbCategorie" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="0">
            <Label text="Niveau *"/>
            <ComboBox fx:id="cbNiveau" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
            <Label text="Prix (TND) *"/>
            <TextField fx:id="tfPrix" promptText="Ex. 25"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="0">
            <Label text="Statut *"/>
            <ComboBox fx:id="cbStatut" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1">
            <Label text="Image URL"/>
            <TextField fx:id="tfImage" promptText="Optionnel"/>
        </VBox>
    </GridPane>

    <TitledPane fx:id="tpProOptions" text="Options professionnelles (formule catalogue, GPS)" expanded="false">
        <VBox spacing="10">
            <VBox spacing="4">
                <Label text="Formule (pack)"/>
                <ComboBox fx:id="cbPack" maxWidth="Infinity"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Latitude (optionnel)"/>
                    <TextField fx:id="tfLat" promptText="Ex. 36.8065"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Longitude (optionnel)"/>
                    <TextField fx:id="tfLng" promptText="Ex. 10.1815"/>
                </VBox>
            </HBox>
        </VBox>
    </TitledPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#onCancel" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: 700; -fx-background-radius: 8; -fx-padding: 8 16;"/>
        <Button fx:id="btnSave" text="Enregistrer" defaultButton="true" onAction="#onSave"
                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 8; -fx-padding: 8 18;"/>
    </HBox>
</VBox>
