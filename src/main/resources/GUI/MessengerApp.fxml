<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1100.0"
            styleClass="root"
            stylesheets="@/css/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MessengerController">

    <top>
            <VBox>
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="topbar">
            <Label styleClass="title" text="Messages" />
                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#toggleAI"
                styleClass="secondaryBtn"
                        text="🤖 IA Assistant">
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </Button>

                <Button fx:id="aiRecordButton" onAction="#handleAiRecord"
                    styleClass="ghostBtn" text="🎙️">
                    <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                </Button>

                <Button onAction="#addNewConversation"
                    styleClass="primaryBtn"
                        text="+ Nouveau">
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox>
            <!-- LEFT SIDEBAR: Conversations List Only -->
            <VBox styleClass="sidebar" style="-fx-border-color: #efefef; -fx-border-width: 0 1 0 0; -fx-min-width: 300; -fx-max-width: 300;">
                <VBox style="-fx-padding: 15;">
                    <TextField fx:id="searchField" promptText="Rechercher..."
                               styleClass="searchInput" />
                </VBox>
                <ListView fx:id="conversationsList" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent; -fx-selection-bar: #f0f2f5;"/>
            </VBox>

            <!-- CENTER: Chat Messages Display -->
            <VBox HBox.vgrow="ALWAYS">
                <HBox fx:id="chatHeader" alignment="CENTER_LEFT" spacing="15" styleClass="topbar">
                    <Circle fill="#e0e0e0" radius="20" />
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="chatUserName" styleClass="title" text="Sélectionnez un chat" />
                        <Label fx:id="chatStatus" styleClass="muted" text="En ligne" />
                    </VBox>

                    <!-- Audio Call Button -->
                    <Button  onAction="#startAudioCall" styleClass="ghostBtn" text="☎️">
                        <font><Font name="Segoe UI Emoji" size="18.0" /></font>
                        <padding>
                            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                        </padding>
                    </Button>

                    <!-- Video Call Button -->
                    <Button onAction="#startVideoCall" styleClass="ghostBtn" text="📹">
                        <font><Font name="Segoe UI Emoji" size="18.0" /></font>
                        <padding>
                            <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
                        </padding>
                    </Button>

                    <Button onAction="#showChatOptions" styleClass="ghostBtn" text="⋮">
                        <font><Font size="20.0" /></font>
                    </Button>
                </HBox>

                <!-- Messages will display here using ListView -->
                <ListView fx:id="messagesList" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-selection-bar: #f0f2f5;"/>

                <!-- Message Input Area -->
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="topbar">

                    <Button onAction="#showEmojiPicker" styleClass="ghostBtn" text="😊">
                        <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                    </Button>

                    <Button onAction="#openGifPicker" styleClass="ghostBtn" text="🎬">
                        <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                    </Button>

                        <Button fx:id="recordButton" onAction="#handleRecordButton"
                            styleClass="ghostBtn" text="🎙️">
                        <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                    </Button>

                    <Button onAction="#handleAttachFile" styleClass="ghostBtn" text="📎">
                        <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                    </Button>


                    <TextField fx:id="messageInput" onKeyPressed="#handleKeyPress" promptText="Repondre..." HBox.hgrow="ALWAYS"
                               styleClass="searchInput" />

                    <Button onAction="#sendLike" styleClass="ghostBtn" text="❤️">
                        <font><Font name="Segoe UI Emoji" size="22.0" /></font>
                    </Button>

                    <Button onAction="#sendMessage" styleClass="primaryBtn" text="➤">
                        <font><Font size="22.0" /></font>
                    </Button>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <right>
          <VBox fx:id="aiPanel" prefWidth="300.0" spacing="10"
              styleClass="card" style="-fx-border-color: #efefef; -fx-border-width: 0 0 0 1;">
            <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Circle fill="#00d1b2" radius="5" />
                <Label styleClass="title" text="Assistant AI" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Online" style="-fx-font-size: 10; -fx-text-fill: #00d1b2;" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="botMessagesContainer" spacing="12" />
            </ScrollPane>

            <VBox spacing="8" style="-fx-padding: 5 0 0 0;">
                <HBox spacing="5">
                        <TextField fx:id="botInput" promptText="Posez une question..." HBox.hgrow="ALWAYS"
                               styleClass="searchInput" />
                        <Button onAction="#askBot"
                            styleClass="primaryBtn"
                            text="?" prefWidth="35" prefHeight="35" />
                </HBox>
                <Label text="L'IA peut générer des erreurs." alignment="CENTER" maxWidth="Infinity"
                       style="-fx-font-size: 9; -fx-text-fill: #aaa;" />
            </VBox>
        </VBox>
    </right>

</BorderPane>
