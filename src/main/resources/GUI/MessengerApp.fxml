<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="660" prefWidth="1100"
            style="-fx-background-color:#ffffff;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MessengerController">

    <!-- ══ LEFT SIDEBAR ═══════════════════════════════════════ -->
    <left>
        <VBox style="-fx-border-color:#e5e7eb;-fx-border-width:0 1 0 0;
                     -fx-min-width:295;-fx-max-width:295;-fx-background-color:#ffffff;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:14 12 10 14;">
                <Label text="💬" style="-fx-font-size:16;-fx-text-fill:#22c55e;"/>
                <Label text="Conversation"
                       style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#toggleAI" text="🤖"
                        style="-fx-background-color:#f3f4f6;-fx-background-radius:8;
                               -fx-cursor:hand;-fx-font-size:14;-fx-padding:5 8;">
                    <font><Font name="Segoe UI Emoji" size="14.0"/></font>
                </Button>
                <Button onAction="#addNewConversation" text="+ Nouveau"
                        style="-fx-background-color:#22c55e;-fx-text-fill:white;
                               -fx-background-radius:8;-fx-cursor:hand;
                               -fx-font-size:11;-fx-font-weight:bold;-fx-padding:6 10;"/>
            </HBox>

            <!-- Search -->
            <VBox style="-fx-padding:0 12 8 12;">
                <TextField fx:id="searchField" promptText="Rechercher une conversation..."
                           style="-fx-background-radius:20;-fx-background-color:#f3f4f6;
                                  -fx-border-color:transparent;-fx-padding:8 14;-fx-font-size:12;"/>
            </VBox>

            <!-- Filter pill tabs -->
            <HBox spacing="5" style="-fx-padding:0 10 10 10;">
                <ToggleButton fx:id="filterTous"    text="Tous"    onAction="#onFilterChanged"/>
                <ToggleButton fx:id="filterNom"     text="Nom"     onAction="#onFilterChanged"/>
                <ToggleButton fx:id="filterDate"    text="Date"    onAction="#onFilterChanged"/>
                <ToggleButton fx:id="filterGroupes" text="Groupes" onAction="#onFilterChanged"/>
                <ToggleButton fx:id="filterPrives"  text="Privés"  onAction="#onFilterChanged"/>
            </HBox>

            <!-- Conversations list -->
            <ListView fx:id="conversationsList" VBox.vgrow="ALWAYS"
                      style="-fx-background-color:transparent;-fx-border-color:transparent;
                             -fx-selection-bar:transparent;-fx-selection-bar-non-focused:transparent;"/>
        </VBox>
    </left>

    <!-- ══ CENTER CHAT ═════════════════════════════════════════ -->
    <center>
        <VBox>

            <!-- Chat header -->
            <HBox fx:id="chatHeader" alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding:11 14;-fx-border-color:#e5e7eb;-fx-border-width:0 0 1 0;
                         -fx-background-color:#ffffff;-fx-min-height:58;-fx-max-height:58;">

                <Label fx:id="chatAvatarLbl" text="?"
                       style="-fx-background-color:#22c55e;-fx-text-fill:white;
                              -fx-background-radius:50;-fx-min-width:38;-fx-min-height:38;
                              -fx-max-width:38;-fx-max-height:38;
                              -fx-alignment:center;-fx-font-weight:bold;-fx-font-size:13;"/>

                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="chatUserName" text="Sélectionnez un chat"
                               style="-fx-font-size:15;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                        <Label fx:id="chatTypeBadge" text=""
                               style="-fx-background-color:#dcfce7;-fx-text-fill:#16a34a;
                                      -fx-background-radius:10;-fx-padding:1 8;
                                      -fx-font-size:10;-fx-font-weight:bold;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Circle fx:id="statusDot" radius="4" fill="#9ca3af"/>
                        <Label fx:id="chatStatus" text="Hors ligne"
                               style="-fx-font-size:11;-fx-text-fill:#6b7280;"/>
                    </HBox>
                </VBox>

                <Button onAction="#startAudioCall" text="📞"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:17;">
                    <font><Font name="Segoe UI Emoji" size="17.0"/></font>
                </Button>
                <Button onAction="#startVideoCall" text="📹"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:17;">
                    <font><Font name="Segoe UI Emoji" size="17.0"/></font>
                </Button>
                <Button onAction="#showChatOptions"
                        style="-fx-background-color:#3b82f6;-fx-text-fill:white;
                               -fx-background-radius:50;-fx-min-width:28;-fx-min-height:28;
                               -fx-max-width:28;-fx-max-height:28;-fx-cursor:hand;
                               -fx-font-weight:bold;-fx-font-size:14;" text="⋮"/>
            </HBox>

            <!-- Messages list -->
            <ListView fx:id="messagesList" VBox.vgrow="ALWAYS"
                      style="-fx-background-color:#f3f4f6;-fx-border-color:transparent;
                             -fx-selection-bar:transparent;-fx-selection-bar-non-focused:transparent;"/>

            <!-- Input bar -->
            <HBox alignment="CENTER" spacing="6"
                  style="-fx-padding:9 12;-fx-border-color:#e5e7eb;-fx-border-width:1 0 0 0;
                         -fx-background-color:#ffffff;-fx-min-height:56;-fx-max-height:56;">

                <Button onAction="#showEmojiPicker" text="😊"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:20;">
                    <font><Font name="Segoe UI Emoji" size="20.0"/></font>
                </Button>

                <TextField fx:id="messageInput" promptText="Type Message..."
                           HBox.hgrow="ALWAYS" onKeyPressed="#handleKeyPress"
                           style="-fx-background-radius:22;-fx-background-color:#f3f4f6;
                                  -fx-border-color:transparent;-fx-padding:9 16;-fx-font-size:13;"/>

                <Button onAction="#sendMessage" text="➤"
                        style="-fx-background-color:#22c55e;-fx-text-fill:white;
                               -fx-background-radius:50;-fx-min-width:36;-fx-min-height:36;
                               -fx-max-width:36;-fx-max-height:36;
                               -fx-cursor:hand;-fx-font-size:14;-fx-font-weight:bold;"/>

                <Button fx:id="recordButton" onAction="#handleRecordButton" text="🎙️"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:20;">
                    <font><Font name="Segoe UI Emoji" size="20.0"/></font>
                </Button>
                <Button onAction="#handleAttachFile" text="📎"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:20;">
                    <font><Font name="Segoe UI Emoji" size="20.0"/></font>
                </Button>
                <Button onAction="#openGifPicker" text="🎬"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:20;">
                    <font><Font name="Segoe UI Emoji" size="20.0"/></font>
                </Button>
                <Button onAction="#sendLike" text="❤️"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:20;">
                    <font><Font name="Segoe UI Emoji" size="20.0"/></font>
                </Button>
            </HBox>
        </VBox>
    </center>

    <!-- ══ RIGHT: AI PANEL ════════════════════════════════════ -->
    <right>
        <VBox fx:id="aiPanel" prefWidth="300" spacing="10"
              style="-fx-background-color:#fafafa;-fx-border-color:#e5e7eb;-fx-border-width:0 0 0 1;">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Circle fill="#22c55e" radius="5"/>
                <Label text="Assistant AI"
                       style="-fx-font-weight:bold;-fx-font-size:14;-fx-text-fill:#111827;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Online" style="-fx-font-size:10;-fx-text-fill:#22c55e;"/>
                <Button fx:id="aiRecordButton" onAction="#handleAiRecord" text="🎙️"
                        style="-fx-background-color:transparent;-fx-cursor:hand;-fx-font-size:16;">
                    <font><Font name="Segoe UI Emoji" size="16.0"/></font>
                </Button>
            </HBox>

            <ProgressIndicator fx:id="aiLoader" visible="false"
                               maxWidth="30" maxHeight="30"
                               style="-fx-accent:#22c55e;"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent;-fx-background:transparent;">
                <VBox fx:id="botMessagesContainer" spacing="10"/>
            </ScrollPane>

            <VBox spacing="6">
                <HBox spacing="6">
                    <TextField fx:id="botInput" promptText="Posez une question..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-radius:14;-fx-background-color:white;
                                      -fx-border-color:#e5e7eb;-fx-border-radius:14;
                                      -fx-padding:8;-fx-font-size:12;"/>
                    <Button onAction="#askBot" text="➤" prefWidth="34" prefHeight="34"
                            style="-fx-background-color:#22c55e;-fx-text-fill:white;
                                   -fx-background-radius:50;-fx-cursor:hand;-fx-font-weight:bold;"/>
                </HBox>
                <Label text="L'IA peut générer des erreurs." alignment="CENTER"
                       maxWidth="Infinity" style="-fx-font-size:9;-fx-text-fill:#aaa;"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>
