<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox fx:id="mainContent" spacing="30" style="-fx-background-color: #f8f9fb; -fx-padding: 40;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="GUI.AdminUsersController" VBox.vgrow="ALWAYS">
    <stylesheets>
        <URL value="@user.css" />
    </stylesheets>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <children>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Communauté EcoAdventure" textFill="#1B4D3E" />
                    <Label style="-fx-font-size: 32; -fx-font-weight: 900;" text="Membres Actifs" textFill="#111827" />
                    <Label style="-fx-font-size: 14;" text="Recherchez et gérez les membres de la plateforme" textFill="#6b7280" />
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #F3F4F6; -fx-padding: 10 20; -fx-background-radius: 25;">
                    <children>
                        <Label style="-fx-text-fill: #9CA3AF;" text="🔍" />
                        <TextField fx:id="txtSearch" promptText="Nom, email, rôle..." style="-fx-background-color: transparent; -fx-pref-width: 250;" />
                    </children>
                </HBox>
                <Button onAction="#showAddModal" prefHeight="50" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-padding: 0 25; -fx-cursor: hand;" text="➕ Ajouter Membre" />
            </children>
        </HBox>

        <!-- Table Headers -->
        <HBox spacing="20" style="-fx-padding: 0 40 0 40;">
            <children>
                <Label prefWidth="250" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="MEMBRE" />
                <Label prefWidth="250" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="COORDONNÉES" />
                <Label alignment="CENTER" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="RÔLE" />
                <Label alignment="CENTER" prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="PROFIL" />
                <Region HBox.hgrow="ALWAYS" />
                <Label alignment="CENTER_RIGHT" style="-fx-font-weight: bold; -fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="ACTIONS" />
            </children>
        </HBox>

        <StackPane style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <children>
                <ListView fx:id="userListView" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS" />
            </children>
        </StackPane>
    </children>
</VBox>