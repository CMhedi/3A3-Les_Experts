<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.PresenceController"
            styleClass="presence-root">

    <stylesheets>
        <URL value="@presence.css"/>
    </stylesheets>

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="15" styleClass="presence-header">

            <Label fx:id="lblSeanceTitle"
                   styleClass="presence-title"
                   text="Appel de présence"/>

            <HBox alignment="CENTER_LEFT" spacing="15">

                <Label fx:id="lblStats"
                       styleClass="presence-stats"
                       text="Présents: 0 | Absents: 0 | Total: 0"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblTaux"
                       styleClass="presence-taux"
                       text="Taux de présence: 0%"/>

            </HBox>

        </VBox>
    </top>

    <!-- ================= TABLE ================= -->
    <center>
        <StackPane style="-fx-padding: 30;">

            <TableView fx:id="tablePresence"
                       styleClass="presence-table"
                       BorderPane.alignment="CENTER">

                <columns>

                    <!-- Avatar + Nom + Email -->
                    <TableColumn fx:id="colNom"
                                 text="Participant"
                                 prefWidth="350"/>

                    <!-- Statut badge -->
                    <TableColumn fx:id="colStatut"
                                 text="Statut"
                                 prefWidth="180"/>

                    <!-- Actions -->
                    <TableColumn fx:id="colAction"
                                 text="Action"
                                 prefWidth="200"/>

                </columns>

            </TableView>

        </StackPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              styleClass="presence-footer"
              style="-fx-padding: 20 40;">

            <Button text="Fermer"
                    styleClass="btn-secondary-modern"
                    onAction="#handleClose"/>

            <Button text="Sauvegarder"
                    styleClass="btn-presence-modern"
                    onAction="#handleSave"/>

            <Button text="Clôturer séance"
                    styleClass="btn-close-seance"
                    onAction="#handleCloturer"/>

        </HBox>
    </bottom>

</BorderPane>