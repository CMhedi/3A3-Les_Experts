<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.UserDashboardController"
            prefWidth="1200"
            prefHeight="700"
            styleClass="root">

    <stylesheets>
        <URL value="@admin.css"/>
    </stylesheets>

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <Label text="Mes Séances"
                   styleClass="title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Retour"
                    onAction="#handleRetour"
                    styleClass="btn-secondary">
                <graphic>
                    <FontAwesomeIconView glyphName="ARROW_LEFT"
                                         size="12"
                                         fill="WHITE"/>
                </graphic>
            </Button>

            <Button styleClass="menu-btn"
                    onAction="#handleSeances">
                <graphic>
                    <FontAwesomeIconView glyphName="CALENDAR"
                                         size="14"
                                         fill="WHITE"/>
                </graphic>
                <text>Séances Disponibles</text>
            </Button>

        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>

        <VBox spacing="30"
              alignment="TOP_CENTER"
              style="-fx-padding:35;">

            <!-- SECTION PLANIFIEES -->
            <Label text="Séances Planifiées"
                   styleClass="section-title-accent"/>

            <ScrollPane fitToWidth="true"
                        styleClass="card-scroll"
                        prefHeight="280">

                <FlowPane fx:id="planifieesContainer"
                          hgap="20"
                          vgap="20"
                          prefWrapLength="950"
                          alignment="TOP_LEFT"
                          style="-fx-padding: 10;"/>

            </ScrollPane>

            <!-- SECTION TERMINEES -->
            <Label text="Séances Terminées"
                   styleClass="section-title-accent"/>

            <ScrollPane fitToWidth="true"
                        styleClass="card-scroll"
                        VBox.vgrow="ALWAYS">

                <FlowPane fx:id="termineesContainer"
                          hgap="20"
                          vgap="20"
                          prefWrapLength="950"
                          alignment="TOP_LEFT"
                          style="-fx-padding: 10;"/>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
